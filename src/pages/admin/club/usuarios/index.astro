  <script type="module">
    // Importar Supabase (ajustar según tu configuración)
    let supabase;
    
    document.addEventListener('DOMContentLoaded', async () => {
      // Datos del servidor pasados al cliente
      const clientData = {
        clubId: '{clientData.clubId}',
        defaultColor: '{clientData.defaultColor}',
        clubName: '{clientData.clubName}',
        clubEmail: '{clientData.clubEmail}',
        clubDescription: '{clientData.clubDescription}',
        clubLogo: '{clientData.clubLogo}',
        clubPhone: '{clientData.clubPhone}',
        clubAddress: '{clientData.clubAddress}',
        clubDomain: '{clientData.clubDomain}',
        clubFacebook: '{clientData.clubFacebook}',
        clubInstagram: '{clientData.clubInstagram}',
        clubPresident: '{clientData.clubPresident}',
        clubFounded: '{clientData.clubFounded}',
        clubTaxId: '{clientData.clubTaxId}',
        clubOfficeHours: '{clientData.clubOfficeHours}'
      };
      
      // Verificar si Supabase está cargado
      if (!window.supabase) {
        await loadSupabaseFromCDN();
      }
      
      supabase = window.supabase;
      
      // Elementos principales
      const form = document.getElementById('club-form');
      const saveBtn = document.getElementById('save-changes');
      const resetBtn = document.getElementById('reset-form');
      const logoutBtn = document.getElementById('logout');
      
      // Elementos de logo
      const uploadLogoBtn = document.getElementById('upload-logo-btn');
      const clearLogoBtn = document.getElementById('clear-logo-btn');
      const logoUrlInput = document.getElementById('club-logo-url');
      const logoPreview = document.getElementById('logo-preview-container');
      
      // Elementos de color
      const colorInput = document.getElementById('club-color');
      const resetColorBtn = document.getElementById('reset-color');
      const colorHex = document.getElementById('color-hex');
      
      // Elementos de contadores
      const nameInput = document.getElementById('club-name');
      const descriptionInput = document.getElementById('club-description');
      
      // Variables de estado
      let originalData = {};
      let selectedLogoFile = null;
      let isUploading = false;
      
      // Inicializar contadores
      updateCounter('name-counter', nameInput.value.length, 100);
      updateCounter('description-counter', descriptionInput.value.length, 500);
      
      // Guardar datos originales
      saveOriginalData();
      
      // Configurar eventos
      setupEventListeners();
      
      // Función para cargar Supabase desde CDN si es necesario
      async function loadSupabaseFromCDN() {
        const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm');
        window.supabase = createClient(
          import.meta.env.PUBLIC_SUPABASE_URL,
          import.meta.env.PUBLIC_SUPABASE_ANON_KEY
        );
      }
      
      function saveOriginalData() {
        const inputs = form.querySelectorAll('input, textarea, select');
        inputs.forEach(input => {
          if (input.name) {
            originalData[input.name] = input.value;
          }
        });
      }
      
      function setupEventListeners() {
        // Contadores de caracteres
        nameInput.addEventListener('input', (e) => {
          updateCounter('name-counter', e.target.value.length, 100);
        });
        
        descriptionInput.addEventListener('input', (e) => {
          updateCounter('description-counter', e.target.value.length, 500);
        });
        
        // Color picker
        colorInput.addEventListener('input', (e) => {
          updateColorPreview(e.target.value);
        });
        
        resetColorBtn.addEventListener('click', () => {
          colorInput.value = '#f97316';
          updateColorPreview('#f97316');
        });
        
        // Copiar slug
        document.getElementById('copy-slug').addEventListener('click', () => {
          const slug = document.getElementById('club-slug').value;
          navigator.clipboard.writeText(slug);
          showNotification('success', 'Slug copiado al portapapeles');
        });
        
        // Subir logo
        uploadLogoBtn.addEventListener('click', () => {
          openUploadModal();
        });
        
        clearLogoBtn.addEventListener('click', () => {
          clearLogo();
        });
        
        // Restaurar formulario
        resetBtn.addEventListener('click', () => {
          restoreOriginalData();
        });
        
        // Guardar cambios
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          await saveChanges();
        });
        
        // Logout
        logoutBtn.addEventListener('click', async () => {
          await supabase.auth.signOut();
          window.location.href = '/admin';
        });
        
        // Cambios en tiempo real (para mostrar estado guardado)
        form.addEventListener('input', debounce(async (e) => {
          const input = e.target;
          if (input.name) {
            await updateField(input.name, input.value);
          }
        }, 1000));
      }
      
      function updateCounter(elementId, length, max) {
        const element = document.getElementById(elementId);
        element.textContent = `${length}/${max}`;
        element.className = length > max * 0.9 
          ? 'text-xs text-amber-400 font-medium'
          : 'text-xs text-gray-500';
      }
      
      function updateColorPreview(color) {
        colorHex.textContent = color;
        document.getElementById('color-preview-primary').style.backgroundColor = color;
        document.getElementById('color-preview-light').style.backgroundColor = color + '20';
        document.getElementById('color-preview-dark').style.backgroundColor = color.replace('#', '#') + 'd9';
      }
      
      function openUploadModal() {
        const modal = document.getElementById('upload-modal');
        const dropZone = document.getElementById('drop-zone');
        const fileInput = document.getElementById('logo-file');
        const preview = document.getElementById('selected-preview');
        const messages = document.getElementById('upload-messages');
        
        // Resetear modal
        preview.classList.add('hidden');
        messages.innerHTML = '';
        selectedLogoFile = null;
        fileInput.value = '';
        
        // Abrir modal
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        
        // Eventos del modal
        dropZone.addEventListener('click', () => fileInput.click());
        dropZone.addEventListener('dragover', (e) => {
          e.preventDefault();
          dropZone.classList.add('border-orange-500', 'bg-gray-700/30');
        });
        dropZone.addEventListener('dragleave', () => {
          dropZone.classList.remove('border-orange-500', 'bg-gray-700/30');
        });
        dropZone.addEventListener('drop', (e) => {
          e.preventDefault();
          dropZone.classList.remove('border-orange-500', 'bg-gray-700/30');
          
          const file = e.dataTransfer.files[0];
          if (file) handleFileSelection(file);
        });
        
        fileInput.addEventListener('change', (e) => {
          const file = e.target.files[0];
          if (file) handleFileSelection(file);
        });
        
        document.getElementById('cancel-upload').addEventListener('click', () => {
          modal.classList.add('hidden');
          document.body.style.overflow = 'auto';
        });
        
        document.getElementById('confirm-upload').addEventListener('click', async () => {
          if (selectedLogoFile) {
            await uploadLogo(selectedLogoFile);
          } else {
            showUploadMessage('error', 'Selecciona un archivo primero');
          }
        });
        
        // Cerrar modal al hacer clic fuera
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            modal.classList.add('hidden');
            document.body.style.overflow = 'auto';
          }
        });
        
        // Cerrar con Escape
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            modal.classList.add('hidden');
            document.body.style.overflow = 'auto';
          }
        });
      }
      
      function handleFileSelection(file) {
        // Validar tipo de archivo
        const validTypes = ['image/png', 'image/jpeg', 'image/svg+xml', 'image/webp'];
        if (!validTypes.includes(file.type)) {
          showUploadMessage('error', 'Formato no válido. Usa PNG, JPG, SVG o WebP.');
          return;
        }
        
        // Validar tamaño (2MB máximo)
        if (file.size > 2 * 1024 * 1024) {
          showUploadMessage('error', 'La imagen es demasiado grande. Máximo 2MB.');
          return;
        }
        
        selectedLogoFile = file;
        
        // Mostrar vista previa
        const reader = new FileReader();
        reader.onload = (e) => {
          const preview = document.getElementById('selected-preview');
          const img = document.getElementById('preview-img');
          const fileInfo = document.getElementById('file-info');
          
          img.src = e.target.result;
          fileInfo.textContent = `${file.name} • ${(file.size / 1024).toFixed(0)} KB`;
          preview.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
      }
      
      async function uploadLogo(file) {
        if (isUploading) return;
        
        isUploading = true;
        const btn = document.getElementById('confirm-upload');
        const originalText = btn.innerHTML;
        
        btn.disabled = true;
        btn.innerHTML = `
          <div class="inline-block animate-spin rounded-full h-5 w-5 border-b-2 border-white mr-2"></div>
          Subiendo...
        `;
        
        try {
          // Subir a Supabase Storage
          const timestamp = Date.now();
          const fileName = `logo_${timestamp}_${file.name.replace(/[^a-zA-Z0-9._-]/g, '_')}`;
          const filePath = `clubs/${clientData.clubId}/${fileName}`;
          
          const { data: uploadData, error: uploadError } = await supabase.storage
            .from('uploads')
            .upload(filePath, file, {
              cacheControl: '3600',
              upsert: true
            });
          
          if (uploadError) throw uploadError;
          
          // Obtener URL pública
          const { data: urlData } = supabase.storage
            .from('uploads')
            .getPublicUrl(filePath);
          
          // Actualizar campo de logo
          logoUrlInput.value = urlData.publicUrl;
          updateLogoPreview(urlData.publicUrl);
          
          // Cerrar modal
          document.getElementById('upload-modal').classList.add('hidden');
          document.body.style.overflow = 'auto';
          
          // Mostrar notificación
          showNotification('success', 'Logo subido exitosamente');
          
          // Actualizar en la base de datos
          await updateField('logo_url', urlData.publicUrl);
          
        } catch (error) {
          console.error('Error subiendo logo:', error);
          showUploadMessage('error', `Error al subir: ${error.message}`);
        } finally {
          isUploading = false;
          btn.disabled = false;
          btn.innerHTML = originalText;
        }
      }
      
      function clearLogo() {
        logoUrlInput.value = '';
        logoPreview.classList.add('hidden');
        showNotification('info', 'Logo eliminado');
        
        // Actualizar en la base de datos
        updateField('logo_url', '');
      }
      
      function updateLogoPreview(url) {
        const container = document.getElementById('logo-preview-container');
        const img = document.querySelector('#logo-preview img');
        
        if (url) {
          if (img) {
            img.src = url;
          } else {
            // Si no hay imagen, crear una
            const logoPreviewDiv = document.getElementById('logo-preview');
            logoPreviewDiv.innerHTML = `
              <img src="${url}" alt="Logo del club" class="max-w-full max-h-full object-contain" 
                   onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\\'text-gray-500 text-center\\'><svg class=\\"w-12 h-12 mx-auto mb-2\\" fill=\\"none\\" stroke=\\"currentColor\\" viewBox=\\"0 0 24 24\\"><path stroke-linecap=\\"round\\" stroke-linejoin=\\"round\\" stroke-width=\\"2\\" d=\\"M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\\"/></svg><p class=\\"text-xs\\">Error cargando</p></div>';">
            `;
          }
          container.classList.remove('hidden');
        } else {
          container.classList.add('hidden');
        }
      }
      
      function restoreOriginalData() {
        Object.keys(originalData).forEach(key => {
          const input = form.querySelector(`[name="${key}"]`);
          if (input) {
            input.value = originalData[key];
            
            // Actualizar vistas previas si es necesario
            if (key === 'color') {
              updateColorPreview(originalData[key]);
            } else if (key === 'logo_url') {
              updateLogoPreview(originalData[key]);
            }
          }
        });
        
        showNotification('info', 'Valores restaurados');
      }
      
      async function saveChanges() {
        const btn = saveBtn;
        const originalText = btn.innerHTML;
        
        btn.disabled = true;
        btn.innerHTML = `
          <div class="inline-block animate-spin rounded-full h-5 w-5 border-b-2 border-white mr-2"></div>
          Guardando...
        `;
        
        try {
          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());
          
          // Validar datos requeridos
          if (!data.name || !data.email) {
            showNotification('error', 'Nombre y email son campos obligatorios');
            return;
          }
          
          // Actualizar en Supabase
          const { error } = await supabase
            .from('clubs')
            .update({
              ...data,
              updated_at: new Date().toISOString()
            })
            .eq('id', clientData.clubId);
          
          if (error) throw error;
          
          // Actualizar datos originales
          saveOriginalData();
          
          // Mostrar modal de éxito
          showSuccessModal();
          
        } catch (error) {
          console.error('Error guardando cambios:', error);
          showNotification('error', `Error al guardar: ${error.message}`);
        } finally {
          btn.disabled = false;
          btn.innerHTML = originalText;
        }
      }
      
      async function updateField(field, value) {
        try {
          const { error } = await supabase
            .from('clubs')
            .update({
              [field]: value,
              updated_at: new Date().toISOString()
            })
            .eq('id', clientData.clubId);
          
          if (!error) {
            // Mostrar estado guardado en la sección correspondiente
            const section = getFieldSection(field);
            const statusElement = document.getElementById(`${section}-status`);
            if (statusElement) {
              statusElement.classList.remove('hidden');
              setTimeout(() => statusElement.classList.add('hidden'), 2000);
            }
          }
        } catch (error) {
          console.error(`Error actualizando campo ${field}:`, error);
        }
      }
      
      function getFieldSection(field) {
        const identityFields = ['name', 'description', 'color', 'logo_url'];
        const contactFields = ['email', 'phone', 'address', 'domain', 'facebook', 'instagram'];
        const legalFields = ['president_name', 'founded_year', 'tax_id', 'office_hours'];
        
        if (identityFields.includes(field)) return 'identity';
        if (contactFields.includes(field)) return 'contact';
        if (legalFields.includes(field)) return 'legal';
        return 'identity';
      }
      
      function showSuccessModal() {
        const modal = document.getElementById('success-modal');
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        
        document.getElementById('close-modal').addEventListener('click', () => {
          modal.classList.add('hidden');
          document.body.style.overflow = 'auto';
        });
        
        // Cerrar al hacer clic fuera
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            modal.classList.add('hidden');
            document.body.style.overflow = 'auto';
          }
        });
      }
      
      function showUploadMessage(type, text) {
        const container = document.getElementById('upload-messages');
        const message = document.createElement('div');
        
        const colors = {
          success: 'bg-emerald-900/30 border-emerald-700/50 text-emerald-300',
          error: 'bg-red-900/30 border-red-700/50 text-red-300',
          info: 'bg-blue-900/30 border-blue-700/50 text-blue-300'
        };
        
        message.className = `p-3 rounded-xl border ${colors[type]}`;
        message.innerHTML = `
          <div class="flex items-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              ${
                type === 'success' 
                  ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>'
                  : type === 'error'
                  ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M9 21a9 9 0 1118 0 9 9 0 01-18 0z"/>'
                  : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>'
              }
            </svg>
            <span class="text-sm">${text}</span>
          </div>
        `;
        
        container.innerHTML = '';
        container.appendChild(message);
        
        if (type !== 'error') {
          setTimeout(() => message.remove(), 5000);
        }
      }
      
      function showNotification(type, message, duration = 5000) {
        const notification = document.createElement('div');
        const colors = {
          success: { bg: 'from-emerald-600 to-green-500', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
          error: { bg: 'from-red-600 to-pink-500', icon: 'M12 9v2m0 4h.01M9 21a9 9 0 1118 0 9 9 0 01-18 0z' },
          info: { bg: 'from-blue-600 to-indigo-500', icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' }
        };
        
        notification.className = `fixed top-6 right-6 z-50 max-w-md transform transition-all duration-500 translate-x-full`;
        notification.innerHTML = `
          <div class="bg-gray-800 rounded-xl shadow-2xl border border-gray-700 overflow-hidden">
            <div class="flex items-start p-4">
              <div class="flex-shrink-0">
                <div class="w-10 h-10 rounded-full bg-gradient-to-r ${colors[type].bg} flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${colors[type].icon}"/>
                  </svg>
                </div>
              </div>
              <div class="ml-4 flex-1">
                <p class="text-sm font-medium text-white">${message}</p>
              </div>
              <button class="ml-4 flex-shrink-0 text-gray-500 hover:text-gray-300 transition-colors" onclick="this.parentElement.parentElement.parentElement.remove()">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>
            </div>
            <div class="h-1 w-full bg-gradient-to-r ${colors[type].bg}"></div>
          </div>
        `;
        
        document.body.appendChild(notification);
        
        // Animar entrada
        requestAnimationFrame(() => {
          notification.classList.remove('translate-x-full');
        });
        
        // Auto-eliminar
        setTimeout(() => {
          notification.classList.add('translate-x-full');
          setTimeout(() => notification.remove(), 500);
        }, duration);
      }
      
      function debounce(func, wait) {
        let timeout;
        return function executedFunction(...args) {
          const later = () => {
            clearTimeout(timeout);
            func(...args);
          };
          clearTimeout(timeout);
          timeout = setTimeout(later, wait);
        };
      }
    });
  </script>
</BaseLayout>