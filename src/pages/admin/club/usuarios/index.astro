---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { supabase } from "@/lib/supabaseClient";

// Verificar sesión en servidor
const { data: sessionData } = await supabase.auth.getSession();

if (!sessionData.session) {
  return new Response(null, {
    status: 302,
    headers: { Location: "/admin" },
  });
}

const user = sessionData.session.user;

// Verificar permisos de administrador
const { data: profile } = await supabase
  .from("profiles")
  .select("role, club_id")
  .eq("id", user.id)
  .single();

if (!profile || profile.role !== "admin") {
  return new Response(null, {
    status: 302,
    headers: { Location: "/admin/dashboard" },
  });
}

// Club
const { data: clubData } = await supabase
  .from("clubs")
  .select("*")
  .eq("id", profile.club_id)
  .single();

// =======================
// Datos para el cliente
// =======================

const defaultColor = clubData?.color || "#f97316";

const slug = clubData?.name
  ? clubData.name
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "")
  : "";

const clientData = {
  clubId: profile.club_id,
  defaultColor,
  slug,
  clubName: clubData?.name ?? "",
  clubEmail: clubData?.email ?? "",
  clubDescription: clubData?.description ?? "",
  clubLogo: clubData?.logo_url ?? "",
  clubPhone: clubData?.phone ?? "",
  clubAddress: clubData?.address ?? "",
  clubDomain: clubData?.domain ?? "",
  clubFacebook: clubData?.facebook ?? "",
  clubInstagram: clubData?.instagram ?? "",
  clubPresident: clubData?.president_name ?? "",
  clubFounded: clubData?.founded_year ?? "",
  clubTaxId: clubData?.tax_id ?? "",
  clubOfficeHours: clubData?.office_hours ?? "",
};
---

<BaseLayout title="Datos Institucionales · Administración">
  <div class="min-h-screen bg-gradient-to-br from-gray-900 via-gray-800 to-gray-950">
  
    <!-- Cabecera de Navegación -->
    <header class="bg-gray-800/95 backdrop-blur-sm shadow-xl border-b border-gray-700/80 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <a 
            href="/admin/dashboard" 
            class="text-gray-400 hover:text-white transition-all duration-300 p-2 hover:bg-gray-700 rounded-xl group"
            title="Volver al panel"
          >
            <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
          </a>
          <div class="h-6 w-px bg-gradient-to-b from-transparent via-gray-600 to-transparent"></div>
          <div class="flex items-center space-x-3">
            <div class="p-2.5 bg-gradient-to-br from-orange-600 to-amber-600 rounded-xl shadow-lg">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
            </div>
            <div>
              <h1 class="font-semibold text-white">Datos Institucionales</h1>
              <p class="text-xs text-gray-400">Identidad oficial del club</p>
            </div>
          </div>
        </div>

        <div class="flex items-center space-x-6">
          <div class="hidden md:flex items-center space-x-3 text-sm bg-gradient-to-r from-emerald-900/30 to-emerald-800/30 px-3 py-1.5 rounded-full border border-emerald-700/50">
            <div class="h-2 w-2 bg-gradient-to-r from-emerald-400 to-emerald-300 rounded-full animate-pulse"></div>
            <span class="text-emerald-300 font-medium">Admin</span>
          </div>
          
          <button
            id="logout"
            class="px-4 py-2.5 text-sm font-medium text-gray-300 hover:text-red-300 hover:bg-red-900/30 rounded-xl transition-all duration-300 flex items-center space-x-2 group"
          >
            <svg class="w-4 h-4 group-hover:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            <span>Cerrar Sesión</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      
      <!-- Cabecera y Estadísticas -->
      <div class="mb-10">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between lg:space-x-8">
          <div class="flex-1">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-3 bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent">
              Configuración Institucional
            </h2>
            <p class="text-gray-400 max-w-3xl">
              Gestiona la identidad visual, datos de contacto y configuración oficial del club. 
              Esta información se muestra en la web pública y materiales oficiales.
            </p>
          </div>
          
          <div class="mt-6 lg:mt-0 flex items-center space-x-4">
            <div class="text-right hidden md:block">
              <p class="text-sm text-gray-500">ID del Club</p>
              <p class="text-sm font-mono font-bold text-gray-300">{clientData.clubId?.substring(0, 8) || 'N/A'}</p>
            </div>
            <div class="text-right">
              <p class="text-sm text-gray-500">Última actualización</p>
              <p class="text-sm font-medium text-gray-300">
                {clientData.updatedAt ? new Date(clientData.updatedAt).toLocaleDateString('es-ES') : 'Nunca'}
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Formulario Principal -->
      <form id="club-form" class="space-y-8">
        
        <!-- Sección 1: Identidad Visual -->
        <div class="bg-gray-800/50 backdrop-blur-sm rounded-2xl border border-gray-700/50 shadow-xl shadow-black/30 overflow-hidden">
          <div class="px-8 py-6 border-b border-gray-700/50 bg-gradient-to-r from-gray-800/50 to-gray-900/50">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-xl font-bold text-white">Identidad Visual</h3>
                <p class="text-sm text-gray-400 mt-1">Marca, logo y apariencia del club</p>
              </div>
              <div class="flex items-center space-x-2">
                <div id="identity-status" class="text-xs text-emerald-400 font-medium px-3 py-1.5 bg-emerald-900/30 rounded-full border border-emerald-700/50 hidden">
                  <span class="flex items-center">
                    <svg class="w-3 h-3 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Guardado
                  </span>
                </div>
              </div>
            </div>
          </div>

          <div class="p-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
              
              <!-- Nombre del Club -->
              <div>
                <label class="block text-sm font-semibold text-gray-200 mb-3">
                  <span class="flex items-center">
                    Nombre oficial del club
                    <span class="text-red-400 ml-1">*</span>
                  </span>
                  <span class="text-xs text-gray-400 font-normal">Nombre completo y legal de la institución</span>
                </label>
                <input
                  type="text"
                  name="name"
                  id="club-name"
                  value={clientData.clubName}
                  required
                  maxlength="100"
                  class="w-full rounded-xl border-2 border-gray-600 bg-gray-900/50 text-white px-5 py-4 text-lg font-medium
                         focus:outline-none focus:ring-3 focus:ring-orange-500/50 focus:border-orange-500
                         transition-all duration-300 hover:border-gray-500 placeholder-gray-500"
                  placeholder="Ej: Club Deportivo Ejemplo S.A."
                />
                <div class="flex justify-between mt-2">
                  <span class="text-xs text-gray-500">Aparecerá en el encabezado y título del sitio</span>
                  <span id="name-counter" class="text-xs text-gray-500">0/100</span>
                </div>
              </div>

              <!-- Slug / URL -->
              <div>
                <label class="block text-sm font-semibold text-gray-200 mb-3">
                  <span class="flex items-center">
                    Identificador único (Slug)
                  </span>
                  <span class="text-xs text-gray-400 font-normal">Se utiliza en URLs y referencias internas</span>
                </label>
                <div class="relative">
                  <input
                    type="text"
                    id="club-slug"
                    value={slug}
                    readonly
                    class="w-full rounded-xl border-2 border-gray-600 px-5 py-4 bg-gray-900/50 text-gray-400
                           font-mono cursor-not-allowed"
                  />
                  <button
                    type="button"
                    id="copy-slug"
                    class="absolute right-3 top-1/2 transform -translate-y-1/2 p-2 text-gray-500 hover:text-gray-300 hover:bg-gray-700 rounded-lg transition-colors"
                    title="Copiar slug"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                    </svg>
                  </button>
                </div>
                <p class="text-xs text-gray-500 mt-2">
                  Generado automáticamente a partir del nombre. No editable.
                </p>
              </div>

              <!-- Descripción -->
              <div class="lg:col-span-2">
                <label class="block text-sm font-semibold text-gray-200 mb-3">
                  <span class="flex items-center">
                    Descripción institucional
                  </span>
                  <span class="text-xs text-gray-400 font-normal">Breve descripción para SEO y presentación</span>
                </label>
                <textarea
                  name="description"
                  id="club-description"
                  rows="3"
                  maxlength="500"
                  class="w-full rounded-xl border-2 border-gray-600 bg-gray-900/50 text-white px-5 py-4
                         focus:outline-none focus:ring-3 focus:ring-orange-500/50 focus:border-orange-500
                         transition-all duration-300 hover:border-gray-500 resize-none placeholder-gray-500"
                  placeholder="Describe la historia, misión y valores del club..."
                >{clientData.clubDescription}</textarea>
                <div class="flex justify-between mt-2">
                  <span class="text-xs text-gray-500">Ideal para meta descripciones y redes sociales</span>
                  <span id="description-counter" class="text-xs text-gray-500">0/500</span>
                </div>
              </div>

              <!-- Color Corporativo -->
              <div>
                <label class="block text-sm font-semibold text-gray-200 mb-3">
                  <span class="flex items-center">
                    Color corporativo
                  </span>
                  <span class="text-xs text-gray-400 font-normal">Color principal de la marca</span>
                </label>
                <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                  <div class="relative">
                    <input
                      type="color"
                      name="color"
                      id="club-color"
                      value={clientData.defaultColor}
                      class="w-16 h-16 rounded-xl border-2 border-gray-600 bg-gray-900 cursor-pointer
                             focus:outline-none focus:ring-3 focus:ring-orange-500/50 focus:border-orange-500"
                    />
                    <div class="absolute -bottom-1 -right-1 w-6 h-6 bg-gray-800 rounded-full border border-gray-600 flex items-center justify-center">
                      <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
                      </svg>
                    </div>
                  </div>
                  
                  <div class="flex-1">
                    <div class="mb-2">
                      <p class="text-xs text-gray-400">Vista previa del color</p>
                    </div>
                    <div class="grid grid-cols-4 gap-2">
                      <div id="color-preview-primary" 
                           class="h-10 rounded-lg border border-gray-600"
                           style={`background-color: ${clientData.defaultColor}`}></div>
                      <div id="color-preview-light" 
                           class="h-10 rounded-lg border border-gray-600"
                           style={`background-color: ${clientData.defaultColor}20`}></div>
                      <div id="color-preview-dark" 
                           class="h-10 rounded-lg border border-gray-600"
                           style={`background-color: ${clientData.defaultColor.replace('#', '#')}d9`}></div>
                      <div class="h-10 rounded-lg border border-gray-600 bg-gradient-to-r from-gray-900 to-gray-700 flex items-center justify-center">
                        <span class="text-xs font-medium text-white">Texto</span>
                      </div>
                    </div>
                    <div class="flex justify-between mt-2">
                      <span id="color-hex" class="text-xs font-mono text-gray-400">{clientData.defaultColor}</span>
                      <button
                        type="button"
                        id="reset-color"
                        class="text-xs text-gray-500 hover:text-gray-300"
                      >
                        Restaurar predeterminado
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Logo del Club -->
              <div>
                <label class="block text-sm font-semibold text-gray-200 mb-3">
                  <span class="flex items-center">
                    Logo oficial
                  </span>
                  <span class="text-xs text-gray-400 font-normal">Imagen principal de la marca</span>
                </label>
                
                <div class="space-y-4">
                  <!-- Input de URL -->
                  <div>
                    <input
                      type="url"
                      name="logo_url"
                      id="club-logo-url"
                      value={clientData.clubLogo}
                      class="w-full rounded-xl border-2 border-gray-600 bg-gray-900/50 text-white px-5 py-3.5
                             focus:outline-none focus:ring-3 focus:ring-orange-500/50 focus:border-orange-500
                             transition-all duration-300 hover:border-gray-500 placeholder-gray-500"
                      placeholder="https://ejemplo.com/logo.png"
                    />
                    <p class="text-xs text-gray-500 mt-2">
                      URL completa del logo. Formatos: PNG, JPG, SVG, WebP
                    </p>
                  </div>
                  
                  <!-- Subir nuevo logo -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <button
                      type="button"
                      id="upload-logo-btn"
                      class="inline-flex items-center justify-center px-4 py-3.5 bg-gradient-to-r from-gray-800 to-gray-900 text-gray-300 font-medium rounded-xl hover:from-gray-700 hover:to-gray-800 transition-all duration-300 shadow-sm hover:shadow-lg border border-gray-700 hover:border-gray-600"
                    >
                      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                      </svg>
                      Subir nuevo logo
                    </button>
                    
                    <button
                      type="button"
                      id="clear-logo-btn"
                      class="inline-flex items-center justify-center px-4 py-3.5 bg-gradient-to-r from-gray-800 to-gray-900 text-gray-300 font-medium rounded-xl hover:from-gray-700 hover:to-gray-800 transition-all duration-300 shadow-sm hover:shadow-lg border border-gray-700 hover:border-gray-600"
                    >
                      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                      Eliminar logo
                    </button>
                  </div>
                  
                  <!-- Vista previa -->
                  <div id="logo-preview-container" class={`${clientData.clubLogo ? '' : 'hidden'}`}>
                    <div class="p-4 bg-gradient-to-r from-gray-800/30 to-gray-900/30 rounded-xl border border-gray-700/50">
                      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Vista previa del logo</p>
                      <div class="flex flex-col sm:flex-row sm:items-center gap-6">
                        <div id="logo-preview" class="w-32 h-32 rounded-xl border border-gray-700 bg-gray-900/50 p-4 flex items-center justify-center">
                          {clientData.clubLogo ? (
                            <img 
                              src={clientData.clubLogo} 
                              alt="Logo del club" 
                              class="max-w-full max-h-full object-contain"
                            />
                          ) : (
                            <div class="text-gray-500 text-center">
                              <svg class="w-12 h-12 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                              </svg>
                              <p class="text-xs">Sin logo</p>
                            </div>
                          )}
                        </div>
                        <div class="flex-1">
                          <p class="text-sm text-gray-400 mb-3">
                            El logo se mostrará en:
                          </p>
                          <ul class="text-xs text-gray-500 space-y-1">
                            <li class="flex items-center">
                              <svg class="w-3 h-3 mr-2 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                              </svg>
                              Encabezado del sitio web
                            </li>
                            <li class="flex items-center">
                              <svg class="w-3 h-3 mr-2 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                              </svg>
                              Tarjetas de noticias
                            </li>
                            <li class="flex items-center">
                              <svg class="w-3 h-3 mr-2 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                              </svg>
                              Documentos oficiales
                            </li>
                            <li class="flex items-center">
                              <svg class="w-3 h-3 mr-2 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                              </svg>
                              Redes sociales
                            </li>
                          </ul>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Sección 2: Datos de Contacto -->
        <div class="bg-gray-800/50 backdrop-blur-sm rounded-2xl border border-gray-700/50 shadow-xl shadow-black/30 overflow-hidden">
          <div class="px-8 py-6 border-b border-gray-700/50 bg-gradient-to-r from-gray-800/50 to-gray-900/50">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-xl font-bold text-white">Datos de Contacto</h3>
                <p class="text-sm text-gray-400 mt-1">Información oficial de comunicación</p>
              </div>
              <div class="flex items-center space-x-2">
                <div id="contact-status" class="text-xs text-emerald-400 font-medium px-3 py-1.5 bg-emerald-900/30 rounded-full border border-emerald-700/50 hidden">
                  <span class="flex items-center">
                    <svg class="w-3 h-3 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Guardado
                  </span>
                </div>
              </div>
            </div>
          </div>

          <div class="p-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
              
              <!-- Email Oficial -->
              <div>
                <label class="block text-sm font-semibold text-gray-200 mb-3">
                  <span class="flex items-center">
                    Email oficial
                    <span class="text-red-400 ml-1">*</span>
                  </span>
                  <span class="text-xs text-gray-400 font-normal">Dirección de contacto principal</span>
                </label>
                <input
                  type="email"
                  name="email"
                  id="club-email"
                  value={clientData.clubEmail}
                  required
                  class="w-full rounded-xl border-2 border-gray-600 bg-gray-900/50 text-white px-5 py-3.5
                         focus:outline-none focus:ring-3 focus:ring-orange-500/50 focus:border-orange-500
                         transition-all duration-300 hover:border-gray-500 placeholder-gray-500"
                  placeholder="contacto@clubdeportivo.com"
                />
                <p class="text-xs text-gray-500 mt-2">
                  Se utilizará para notificaciones y formularios de contacto
                </p>
              </div>

              <!-- Teléfono -->
              <div>
                <label class="block text-sm font-semibold text-gray-200 mb-3">
                  <span class="flex items-center">
                    Teléfono de contacto
                  </span>
                  <span class="text-xs text-gray-400 font-normal">Número principal del club</span>
                </label>
                <input
                  type="tel"
                  name="phone"
                  id="club-phone"
                  value={clientData.clubPhone}
                  class="w-full rounded-xl border-2 border-gray-600 bg-gray-900/50 text-white px-5 py-3.5
                         focus:outline-none focus:ring-3 focus:ring-orange-500/50 focus:border-orange-500
                         transition-all duration-300 hover:border-gray-500 placeholder-gray-500"
                  placeholder="+34 912 345 678"
                />
              </div>

              <!-- Dirección -->
              <div class="lg:col-span-2">
                <label class="block text-sm font-semibold text-gray-200 mb-3">
                  <span class="flex items-center">
                    Dirección física
                  </span>
                  <span class="text-xs text-gray-400 font-normal">Ubicación oficial del club</span>
                </label>
                <input
                  type="text"
                  name="address"
                  id="club-address"
                  value={clientData.clubAddress}
                  class="w-full rounded-xl border-2 border-gray-600 bg-gray-900/50 text-white px-5 py-3.5
                         focus:outline-none focus:ring-3 focus:ring-orange-500/50 focus:border-orange-500
                         transition-all duration-300 hover:border-gray-500 placeholder-gray-500"
                  placeholder="Calle Ejemplo, 123 - 28001 Madrid"
                />
              </div>

              <!-- Dominio Web -->
              <div>
                <label class="block text-sm font-semibold text-gray-200 mb-3">
                  <span class="flex items-center">
                    Dominio web principal
                  </span>
                  <span class="text-xs text-gray-400 font-normal">URL oficial del sitio web</span>
                </label>
                <div class="flex items-center">
