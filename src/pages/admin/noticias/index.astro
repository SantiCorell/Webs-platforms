---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Gestión de Noticias · Administración">
  <div class="min-h-screen bg-neutral-50">

    <!-- Cabecera de Navegación -->
    <header class="bg-white shadow-sm border-b border-neutral-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <a 
            href="/admin/dashboard" 
            class="text-neutral-600 hover:text-neutral-900 transition-colors p-2 hover:bg-neutral-100 rounded-lg flex items-center space-x-2"
            title="Volver al panel principal"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            <span class="hidden sm:inline text-sm font-medium">Panel</span>
          </a>
          <div class="h-6 w-px bg-neutral-200"></div>
          <div>
            <h1 class="font-semibold text-neutral-900">Gestión de Noticias</h1>
            <p class="text-xs text-neutral-500">Comunicados oficiales del club</p>
          </div>
        </div>

        <div class="flex items-center space-x-6">
          <div class="hidden md:flex items-center space-x-3 text-sm">
            <div class="h-2 w-2 bg-green-500 rounded-full animate-pulse"></div>
            <span class="text-neutral-600">Modo Editor</span>
          </div>
          
          <a
            href="/admin/noticias/nueva"
            class="inline-flex items-center px-5 py-2.5 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-all duration-200 shadow-sm hover:shadow"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Nueva Noticia
          </a>

          <button
            id="logout"
            class="px-4 py-2 text-sm font-medium text-neutral-700 hover:text-red-700 hover:bg-red-50 rounded-lg transition-colors duration-200 flex items-center space-x-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            <span>Cerrar Sesión</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      
      <!-- Cabecera y Filtros -->
      <div class="mb-8">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between lg:space-x-8">
          <div class="flex-1">
            <h2 class="text-2xl md:text-3xl font-bold text-neutral-900">Gestión de Noticias</h2>
            <p class="text-neutral-600 mt-2">
              Administra los comunicados, artículos y novedades oficiales del club
            </p>
          </div>
          
          <div class="mt-6 lg:mt-0 flex items-center space-x-4">
            <div class="text-right">
              <p class="text-sm text-neutral-500">Publicadas</p>
              <p id="published-count" class="text-2xl font-bold text-green-600">--</p>
            </div>
            <div class="text-right">
              <p class="text-sm text-neutral-500">Borradores</p>
              <p id="draft-count" class="text-2xl font-bold text-amber-600">--</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Barra de Herramientas -->
      <div class="mb-6">
        <div class="bg-white rounded-xl border border-neutral-200 shadow-sm p-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center space-x-4">
              <!-- Filtro por Estado -->
              <div class="flex items-center space-x-2">
                <span class="text-sm text-neutral-700">Estado:</span>
                <div class="flex bg-neutral-100 rounded-lg p-1">
                  <button
                    data-filter="all"
                    class="filter-btn px-3 py-1.5 text-sm font-medium rounded-md transition-all bg-white shadow-sm border border-neutral-200"
                  >
                    Todas
                  </button>
                  <button
                    data-filter="published"
                    class="filter-btn px-3 py-1.5 text-sm font-medium rounded-md transition-all text-neutral-600 hover:text-neutral-900"
                  >
                    Publicadas
                  </button>
                  <button
                    data-filter="draft"
                    class="filter-btn px-3 py-1.5 text-sm font-medium rounded-md transition-all text-neutral-600 hover:text-neutral-900"
                  >
                    Borradores
                  </button>
                </div>
              </div>

              <!-- Filtro por Fecha -->
              <div class="flex items-center space-x-2">
                <span class="text-sm text-neutral-700">Orden:</span>
                <select
                  id="sort-select"
                  class="px-3 py-1.5 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm bg-white cursor-pointer"
                >
                  <option value="newest">Más recientes</option>
                  <option value="oldest">Más antiguas</option>
                  <option value="title">Título (A-Z)</option>
                </select>
              </div>
            </div>

            <!-- Búsqueda -->
            <div class="relative w-full sm:w-auto">
              <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
              <input
                type="text"
                id="search-input"
                placeholder="Buscar noticias..."
                class="w-full sm:w-64 pl-10 pr-4 py-2 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Estado de Carga -->
      <div id="loading-state" class="text-center py-12">
        <div class="inline-block animate-spin rounded-full h-10 w-10 border-b-2 border-blue-600 mb-4"></div>
        <p class="text-neutral-600">Cargando noticias...</p>
      </div>

      <!-- Estado Vacío -->
      <div id="empty-state" class="hidden text-center py-16 bg-white rounded-xl border border-dashed border-neutral-300">
        <svg class="w-20 h-20 text-neutral-300 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
        </svg>
        <h4 class="text-xl font-semibold text-neutral-900 mb-2">No hay noticias publicadas</h4>
        <p class="text-neutral-600 max-w-md mx-auto mb-8">
          Comienza creando la primera noticia para compartir novedades con la comunidad del club.
        </p>
        <a
          href="/admin/noticias/nueva"
          class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-all duration-200"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Crear Primera Noticia
        </a>
      </div>

      <!-- Listado de Noticias -->
      <div id="news-container" class="hidden">
        <div class="bg-white rounded-xl border border-neutral-200 shadow-sm overflow-hidden">
          <!-- Cabecera de la Tabla -->
          <div class="px-6 py-4 border-b border-neutral-200 bg-neutral-50">
            <div class="grid grid-cols-12 gap-4 text-sm font-medium text-neutral-700">
              <div class="col-span-6 lg:col-span-5">Título y Estado</div>
              <div class="col-span-3 lg:col-span-3">Fecha</div>
              <div class="col-span-3 lg:col-span-2">Autor</div>
              <div class="col-span-3 lg:col-span-2 text-right">Acciones</div>
            </div>
          </div>

          <!-- Lista de Noticias -->
          <ul id="news-list" class="divide-y divide-neutral-100"></ul>

          <!-- Pie de Tabla -->
          <div class="px-6 py-4 border-t border-neutral-200 bg-neutral-50">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between text-sm text-neutral-600">
              <div>
                Mostrando <span id="current-count">0</span> de <span id="total-count">0</span> noticias
              </div>
              <div class="mt-2 sm:mt-0">
                <a
                  href="/admin/noticias/nueva"
                  class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium"
                >
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                  </svg>
                  Añadir otra noticia
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Paginación -->
      <div id="pagination" class="hidden mt-6">
        <div class="flex items-center justify-between">
          <button
            id="prev-page"
            class="inline-flex items-center px-4 py-2 border border-neutral-300 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-50 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Anterior
          </button>
          
          <div class="flex items-center space-x-2">
            <span class="text-sm text-neutral-600">Página</span>
            <div class="flex bg-neutral-100 rounded-lg p-1">
              <button class="page-btn px-3 py-1 text-sm font-medium rounded bg-white shadow-sm border border-neutral-200">1</button>
              <button class="page-btn px-3 py-1 text-sm font-medium rounded text-neutral-600 hover:text-neutral-900">2</button>
              <button class="page-btn px-3 py-1 text-sm font-medium rounded text-neutral-600 hover:text-neutral-900">3</button>
            </div>
          </div>
          
          <button
            id="next-page"
            class="inline-flex items-center px-4 py-2 border border-neutral-300 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-50 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Siguiente
            <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>
    </main>
  </div>

  <!-- Modal de Confirmación -->
  <div id="delete-modal" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
      <!-- Fondo -->
      <div class="fixed inset-0 transition-opacity bg-neutral-900 bg-opacity-50"></div>

      <!-- Modal -->
      <div class="inline-block align-bottom bg-white rounded-xl shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
        <div class="px-6 py-6">
          <div class="flex items-center justify-center w-12 h-12 mx-auto bg-red-100 rounded-full">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.856-.833-2.624 0L4.732 16.5c-.77.833.192 2.5 1.732 2.5z"/>
            </svg>
          </div>
          
          <div class="mt-4 text-center">
            <h3 class="text-lg font-semibold text-neutral-900">Confirmar Eliminación</h3>
            <p class="mt-2 text-sm text-neutral-600">
              ¿Estás seguro de que deseas eliminar esta noticia?
              <br>
              <span class="font-medium" id="modal-news-title"></span>
            </p>
            <p class="mt-2 text-xs text-neutral-500">
              Esta acción no se puede deshacer y la noticia será eliminada permanentemente.
            </p>
          </div>

          <div class="mt-6 flex flex-col sm:flex-row sm:space-x-3 space-y-3 sm:space-y-0">
            <button
              id="modal-cancel"
              type="button"
              class="flex-1 px-4 py-2.5 border border-neutral-300 text-neutral-700 font-medium rounded-lg hover:bg-neutral-50 transition-colors"
            >
              Cancelar
            </button>
            <button
              id="modal-confirm"
              type="button"
              class="flex-1 px-4 py-2.5 bg-red-600 text-white font-medium rounded-lg hover:bg-red-700 transition-colors flex items-center justify-center"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
              Eliminar Noticia
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="module">
    import { supabase } from "../../../lib/supabaseClient";

    // Estado global
    let allNews = [];
    let currentFilter = 'all';
    let currentPage = 1;
    const itemsPerPage = 10;
    let newsToDelete = null;

    // Inicialización
    document.addEventListener('DOMContentLoaded', async () => {
      // Verificar sesión y permisos
      const { data: sessionData } = await supabase.auth.getSession();
      if (!sessionData.session) {
        window.location.href = "/admin?error=session_expired";
        return;
      }

      const user = sessionData.session.user;

      const { data: profile } = await supabase
        .from("profiles")
        .select("role, club_id, full_name")
        .eq("id", user.id)
        .single();

      if (!profile || !["admin", "cronica", "editor"].includes(profile.role)) {
        showNotification('error', 'No tienes permisos suficientes para acceder a esta área');
        setTimeout(() => window.location.href = "/admin/dashboard", 2000);
        return;
      }

      // Cargar noticias
      await loadNews(profile.club_id);

      // Configurar filtros y búsqueda
      setupFilters();

      // Configurar modal
      setupModal();

      // Logout
      document.getElementById('logout').addEventListener('click', async () => {
        await supabase.auth.signOut();
        window.location.href = "/admin";
      });
    });

    async function loadNews(clubId) {
      const loadingEl = document.getElementById('loading-state');
      const containerEl = document.getElementById('news-container');
      const emptyEl = document.getElementById('empty-state');

      try {
        const { data: news, error } = await supabase
          .from("news")
          .select(`
            id,
            title,
            excerpt,
            created_at,
            published,
            published_at,
            author_id,
            views,
            profiles:author_id ( full_name, avatar_url )
          `)
          .eq("club_id", clubId)
          .order("created_at", { ascending: false });

        if (error) throw error;

        allNews = news || [];
        
        loadingEl.classList.add('hidden');
        
        if (allNews.length === 0) {
          emptyEl.classList.remove('hidden');
          containerEl.classList.add('hidden');
          updateCounts();
          return;
        }

        emptyEl.classList.add('hidden');
        containerEl.classList.remove('hidden');
        
        filterAndRenderNews();
        updateCounts();

      } catch (error) {
        console.error('Error cargando noticias:', error);
        loadingEl.classList.add('hidden');
        showNotification('error', 'Error al cargar las noticias. Intenta recargar la página.');
      }
    }

    function filterAndRenderNews() {
      let filtered = [...allNews];
      
      // Aplicar filtro de estado
      if (currentFilter === 'published') {
        filtered = filtered.filter(item => item.published);
      } else if (currentFilter === 'draft') {
        filtered = filtered.filter(item => !item.published);
      }
      
      // Aplicar búsqueda
      const searchTerm = document.getElementById('search-input').value.toLowerCase();
      if (searchTerm) {
        filtered = filtered.filter(item => 
          item.title.toLowerCase().includes(searchTerm) ||
          (item.excerpt && item.excerpt.toLowerCase().includes(searchTerm))
        );
      }
      
      // Aplicar orden
      const sortOrder = document.getElementById('sort-select').value;
      switch (sortOrder) {
        case 'oldest':
          filtered.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
          break;
        case 'title':
          filtered.sort((a, b) => a.title.localeCompare(b.title));
          break;
        case 'newest':
        default:
          filtered.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
          break;
      }
      
      renderNews(filtered);
      updatePagination(filtered.length);
    }

    function renderNews(news) {
      const listEl = document.getElementById('news-list');
      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;
      const paginatedNews = news.slice(startIndex, endIndex);

      listEl.innerHTML = '';

      if (paginatedNews.length === 0) {
        const emptyRow = document.createElement('li');
        emptyRow.className = 'px-6 py-8 text-center';
        emptyRow.innerHTML = `
          <p class="text-neutral-500">No hay noticias que coincidan con los filtros seleccionados</p>
        `;
        listEl.appendChild(emptyRow);
        return;
      }

      paginatedNews.forEach(item => {
        const authorName = item.profiles?.full_name || 'Sin autor';
        const createdDate = new Date(item.created_at);
        const publishedDate = item.published_at ? new Date(item.published_at) : null;
        
        const formattedDate = publishedDate 
          ? publishedDate.toLocaleDateString('es-ES', {
              year: 'numeric',
              month: 'short',
              day: 'numeric'
            })
          : createdDate.toLocaleDateString('es-ES', {
              year: 'numeric',
              month: 'short',
              day: 'numeric'
            });

        const statusBadge = item.published 
          ? `<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
               <span class="w-1.5 h-1.5 bg-green-500 rounded-full mr-1.5"></span>
               Publicada
             </span>`
          : `<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
               <span class="w-1.5 h-1.5 bg-amber-500 rounded-full mr-1.5"></span>
               Borrador
             </span>`;

        const excerpt = item.excerpt 
          ? item.excerpt.substring(0, 100) + (item.excerpt.length > 100 ? '...' : '')
          : 'Sin descripción';

        const li = document.createElement('li');
        li.className = 'px-6 py-4 hover:bg-neutral-50 transition-colors';
        li.innerHTML = `
          <div class="grid grid-cols-12 gap-4 items-center">
            <!-- Título y Estado -->
            <div class="col-span-6 lg:col-span-5">
              <div class="flex items-start space-x-3">
                <div class="flex-1 min-w-0">
                  <h4 class="font-semibold text-neutral-900 truncate hover:text-blue-600 transition-colors">
                    ${escapeHtml(item.title)}
                  </h4>
                  <p class="text-sm text-neutral-600 mt-1 truncate">${escapeHtml(excerpt)}</p>
                  <div class="flex items-center space-x-3 mt-2">
                    ${statusBadge}
                    ${item.views ? `
                      <span class="text-xs text-neutral-500 flex items-center">
                        <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                        ${item.views} vistas
                      </span>
                    ` : ''}
                  </div>
                </div>
              </div>
            </div>

            <!-- Fecha -->
            <div class="col-span-3 lg:col-span-3">
              <div class="text-sm text-neutral-900">${formattedDate}</div>
              <div class="text-xs text-neutral-500">
                ${item.published ? 'Publicada' : 'Creada'}
              </div>
            </div>

            <!-- Autor -->
            <div class="col-span-3 lg:col-span-2">
              <div class="flex items-center space-x-2">
                <div class="w-8 h-8 rounded-full bg-neutral-200 flex items-center justify-center text-xs font-medium text-neutral-600">
                  ${authorName.charAt(0).toUpperCase()}
                </div>
                <div>
                  <div class="text-sm font-medium text-neutral-900 truncate">${authorName}</div>
                </div>
              </div>
            </div>

            <!-- Acciones -->
            <div class="col-span-3 lg:col-span-2">
              <div class="flex items-center justify-end space-x-2">
                <a
                  href="/admin/noticias/editar/${item.id}"
                  class="inline-flex items-center p-2 text-neutral-600 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors"
                  title="Editar noticia"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                  </svg>
                </a>
                
                <a
                  href="/noticias/${item.id}"
                  target="_blank"
                  class="inline-flex items-center p-2 text-neutral-600 hover:text-green-600 hover:bg-green-50 rounded-lg transition-colors"
                  title="Ver en público"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                </a>
                
                <button
                  data-id="${item.id}"
                  data-title="${escapeHtml(item.title)}"
                  class="delete-btn inline-flex items-center p-2 text-neutral-600 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors"
                  title="Eliminar noticia"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        `;

        listEl.appendChild(li);
      });

      // Agregar eventos a botones de eliminar
      document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          newsToDelete = {
            id: btn.getAttribute('data-id'),
            title: btn.getAttribute('data-title')
          };
          showDeleteModal();
        });
      });

      // Actualizar contadores
      document.getElementById('current-count').textContent = paginatedNews.length;
      document.getElementById('total-count').textContent = news.length;
    }

    function setupFilters() {
      const filterButtons = document.querySelectorAll('.filter-btn');
      const searchInput = document.getElementById('search-input');
      const sortSelect = document.getElementById('sort-select');
      const prevBtn = document.getElementById('prev-page');
      const nextBtn = document.getElementById('next-page');

      // Botones de filtro
      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          filterButtons.forEach(b => {
            b.classList.remove('bg-white', 'shadow-sm', 'border', 'border-neutral-200');
            b.classList.add('text-neutral-600', 'hover:text-neutral-900');
          });
          
          btn.classList.remove('text-neutral-600', 'hover:text-neutral-900');
          btn.classList.add('bg-white', 'shadow-sm', 'border', 'border-neutral-200');
          
          currentFilter = btn.getAttribute('data-filter');
          currentPage = 1;
          filterAndRenderNews();
        });
      });

      // Búsqueda
      let searchTimeout;
      searchInput.addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          currentPage = 1;
          filterAndRenderNews();
        }, 300);
      });

      // Orden
      sortSelect.addEventListener('change', () => {
        currentPage = 1;
        filterAndRenderNews();
      });

      // Paginación
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          filterAndRenderNews();
        }
      });

      nextBtn.addEventListener('click', () => {
        const filtered = getFilteredNews();
        const totalPages = Math.ceil(filtered.length / itemsPerPage);
        if (currentPage < totalPages) {
          currentPage++;
          filterAndRenderNews();
        }
      });
    }

    function getFilteredNews() {
      let filtered = [...allNews];
      
      if (currentFilter === 'published') {
        filtered = filtered.filter(item => item.published);
      } else if (currentFilter === 'draft') {
        filtered = filtered.filter(item => !item.published);
      }
      
      const searchTerm = document.getElementById('search-input').value.toLowerCase();
      if (searchTerm) {
        filtered = filtered.filter(item => 
          item.title.toLowerCase().includes(searchTerm) ||
          (item.excerpt && item.excerpt.toLowerCase().includes(searchTerm))
        );
      }
      
      return filtered;
    }

    function updatePagination(totalItems) {
      const totalPages = Math.ceil(totalItems / itemsPerPage);
      const paginationEl = document.getElementById('pagination');
      
      if (totalPages > 1) {
        paginationEl.classList.remove('hidden');
      } else {
        paginationEl.classList.add('hidden');
      }
      
      document.getElementById('prev-page').disabled = currentPage === 1;
      document.getElementById('next-page').disabled = currentPage === totalPages;
    }

    function updateCounts() {
      const publishedCount = allNews.filter(item => item.published).length;
      const draftCount = allNews.filter(item => !item.published).length;
      
      document.getElementById('published-count').textContent = publishedCount;
      document.getElementById('draft-count').textContent = draftCount;
    }

    function setupModal() {
      const modal = document.getElementById('delete-modal');
      const cancelBtn = document.getElementById('modal-cancel');
      const confirmBtn = document.getElementById('modal-confirm');

      cancelBtn.addEventListener('click', hideDeleteModal);
      
      confirmBtn.addEventListener('click', async () => {
        if (!newsToDelete) return;
        
        confirmBtn.disabled = true;
        confirmBtn.innerHTML = `
          <div class="inline-block animate-spin rounded-full h-5 w-5 border-b-2 border-white mr-2"></div>
          Eliminando...
        `;
        
        try {
          const { error } = await supabase
            .from("news")
            .delete()
            .eq("id", newsToDelete.id);
          
          if (error) throw error;
          
          hideDeleteModal();
          showNotification('success', 'Noticia eliminada exitosamente');
          
          // Recargar noticias
          const { data: profile } = await supabase
            .from("profiles")
            .select("club_id")
            .eq("id", (await supabase.auth.getSession()).data.session.user.id)
            .single();
          
          await loadNews(profile.club_id);
          
        } catch (error) {
          console.error('Error eliminando noticia:', error);
          showNotification('error', 'Error al eliminar la noticia. Intenta nuevamente.');
          confirmBtn.disabled = false;
          confirmBtn.innerHTML = `
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
            Eliminar Noticia
          `;
        }
      });

      // Cerrar modal al hacer clic fuera
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          hideDeleteModal();
        }
      });

      // Cerrar con Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
          hideDeleteModal();
        }
      });
    }

    function showDeleteModal() {
      if (!newsToDelete) return;
      
      document.getElementById('modal-news-title').textContent = newsToDelete.title;
      document.getElementById('delete-modal').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function hideDeleteModal() {
      document.getElementById('delete-modal').classList.add('hidden');
      document.body.style.overflow = 'auto';
      newsToDelete = null;
      document.getElementById('modal-confirm').disabled = false;
      document.getElementById('modal-confirm').innerHTML = `
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        Eliminar Noticia
      `;
    }

    // Funciones utilitarias
    function escapeHtml(text) {
      if (!text) return '';
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function showNotification(type, message) {
      const notification = document.createElement('div');
      notification.className = `fixed top-4 right-4 z-50 max-w-md transform transition-all duration-300 translate-x-full`;
      notification.innerHTML = `
        <div class="p-4 rounded-lg shadow-lg border ${
          type === 'success' 
            ? 'bg-green-50 border-green-200 text-green-800' 
            : 'bg-red-50 border-red-200 text-red-800'
        }">
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              ${
                type === 'success'
                  ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>'
                  : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M9 21a9 9 0 1118 0 9 9 0 01-18 0z"/>'
              }
            </svg>
            <span class="text-sm font-medium">${message}</span>
          </div>
        </div>
      `;
      
      document.body.appendChild(notification);
      
      // Animar entrada
      requestAnimationFrame(() => {
        notification.classList.remove('translate-x-full');
      });
      
      // Auto-eliminar
      setTimeout(() => {
        notification.classList.add('translate-x-full');
        setTimeout(() => notification.remove(), 300);
      }, 5000);
    }
  </script>
</BaseLayout>