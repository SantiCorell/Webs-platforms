---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Crear Noticia · Administración">
  <div class="min-h-screen bg-gradient-to-br from-neutral-50 via-white to-blue-50/30">

    <!-- Cabecera de Navegación -->
    <header class="bg-white/95 backdrop-blur-sm shadow-lg border-b border-neutral-200/80 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <a 
            href="/admin/noticias" 
            class="text-neutral-600 hover:text-neutral-900 transition-all duration-300 p-2 hover:bg-neutral-100 rounded-xl group"
            title="Volver al listado"
          >
            <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
          </a>
          <div class="h-6 w-px bg-gradient-to-b from-transparent via-neutral-300 to-transparent"></div>
          <div class="flex items-center space-x-3">
            <div class="p-2.5 bg-gradient-to-br from-blue-600 to-indigo-600 rounded-xl shadow-lg">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
            </div>
            <div>
              <h1 class="font-semibold text-neutral-900">Crear Nueva Noticia</h1>
              <p class="text-xs text-neutral-500">Publica contenido oficial del club</p>
            </div>
          </div>
        </div>

        <div class="flex items-center space-x-6">
          <div class="hidden md:flex items-center space-x-3 text-sm bg-gradient-to-r from-green-50 to-emerald-50 px-3 py-1.5 rounded-full border border-green-100">
            <div class="h-2 w-2 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full animate-pulse"></div>
            <span class="text-green-700 font-medium">Modo Creación</span>
          </div>
          
          <button
            id="logout"
            class="px-4 py-2.5 text-sm font-medium text-neutral-700 hover:text-red-700 hover:bg-red-50 rounded-xl transition-all duration-300 flex items-center space-x-2 group"
          >
            <svg class="w-4 h-4 group-hover:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            <span>Cerrar Sesión</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      
      <!-- Cabecera del Creador -->
      <div class="mb-10">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between lg:space-x-8">
          <div class="flex-1">
            <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-3 bg-gradient-to-r from-neutral-900 to-neutral-700 bg-clip-text text-transparent">
              Crear Nueva Noticia
            </h2>
            <p class="text-neutral-600 max-w-3xl">
              Completa todos los campos para publicar una nueva noticia. Los campos marcados con * son obligatorios.
            </p>
          </div>
          
          <div class="mt-6 lg:mt-0 flex items-center space-x-6">
            <div class="text-right hidden md:block">
              <p class="text-sm text-neutral-500">Guía de publicación</p>
              <a 
                href="#publishing-guide" 
                class="text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors"
              >
                Ver recomendaciones
              </a>
            </div>
            <div class="text-right">
              <p class="text-sm text-neutral-500">Tiempo estimado</p>
              <p class="text-xl font-bold text-neutral-900">5 min</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contenedor del Formulario -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Área de Creación Principal -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-2xl border border-neutral-200/80 shadow-xl shadow-neutral-200/30 overflow-hidden transition-all duration-500 hover:shadow-2xl hover:shadow-neutral-300/50">
            <div class="px-8 py-6 border-b border-neutral-200 bg-gradient-to-r from-white to-neutral-50">
              <div class="flex items-center justify-between">
                <h3 class="text-xl font-bold text-neutral-900">Detalles de la Noticia</h3>
                <div class="flex items-center space-x-2">
                  <div id="form-status" class="text-xs text-emerald-600 font-medium px-3 py-1.5 bg-emerald-50 rounded-full border border-emerald-200">
                    <span class="flex items-center">
                      <svg class="w-3 h-3 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      Borrador
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <form id="news-form" class="p-8">
              <!-- Título -->
              <div class="mb-8">
                <label class="block text-sm font-semibold text-neutral-900 mb-3">
                  <span class="flex items-center">
                    Título de la noticia
                    <span class="text-red-500 ml-1">*</span>
                  </span>
                  <span class="text-xs text-neutral-500 font-normal">Título atractivo y descriptivo (máx. 120 caracteres)</span>
                </label>
                <input
                  type="text"
                  name="title"
                  required
                  maxlength="120"
                  class="w-full rounded-xl border-2 border-neutral-300 px-5 py-4 text-lg font-medium
                         focus:outline-none focus:ring-3 focus:ring-blue-500/30 focus:border-blue-500
                         transition-all duration-300 hover:border-neutral-400"
                  placeholder="Ej: El club gana el campeonato regional 2024"
                  autofocus
                />
                <div class="flex justify-between mt-2">
                  <span class="text-xs text-neutral-400">Aparecerá en el listado principal y redes sociales</span>
                  <span id="title-counter" class="text-xs text-neutral-400">0/120</span>
                </div>
              </div>

              <!-- Extracto -->
              <div class="mb-8">
                <label class="block text-sm font-semibold text-neutral-900 mb-3">
                  <span class="flex items-center">
                    Extracto o descripción corta
                    <span class="text-amber-500 ml-1">*</span>
                  </span>
                  <span class="text-xs text-neutral-500 font-normal">Breve resumen que aparecerá en tarjetas y redes sociales</span>
                </label>
                <textarea
                  name="excerpt"
                  rows="3"
                  maxlength="300"
                  required
                  class="w-full rounded-xl border-2 border-neutral-300 px-5 py-4
                         focus:outline-none focus:ring-3 focus:ring-blue-500/30 focus:border-blue-500
                         transition-all duration-300 hover:border-neutral-400 resize-none"
                  placeholder="Describe brevemente el contenido de la noticia (mín. 50 caracteres)..."
                ></textarea>
                <div class="flex justify-between mt-2">
                  <span class="text-xs text-neutral-400">Fundamental para SEO y compartir en redes</span>
                  <span id="excerpt-counter" class="text-xs text-neutral-400">0/300</span>
                </div>
              </div>

              <!-- Contenido Principal -->
              <div class="mb-8">
                <div class="flex items-center justify-between mb-3">
                  <label class="block text-sm font-semibold text-neutral-900">
                    <span class="flex items-center">
                      Contenido de la noticia
                      <span class="text-red-500 ml-1">*</span>
                    </span>
                    <span class="text-xs text-neutral-500 font-normal">Cuerpo completo del artículo</span>
                  </label>
                  <div class="flex items-center space-x-2">
                    <button
                      type="button"
                      id="format-bold"
                      class="p-2 text-neutral-500 hover:text-neutral-900 hover:bg-neutral-100 rounded-lg transition-colors"
                      title="Negrita (Ctrl+B)"
                    >
                      <span class="font-bold">B</span>
                    </button>
                    <button
                      type="button"
                      id="format-italic"
                      class="p-2 text-neutral-500 hover:text-neutral-900 hover:bg-neutral-100 rounded-lg transition-colors"
                      title="Cursiva (Ctrl+I)"
                    >
                      <span class="italic">I</span>
                    </button>
                    <button
                      type="button"
                      id="format-link"
                      class="p-2 text-neutral-500 hover:text-neutral-900 hover:bg-neutral-100 rounded-lg transition-colors"
                      title="Insertar enlace (Ctrl+K)"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                      </svg>
                    </button>
                  </div>
                </div>
                <textarea
                  name="content"
                  rows="12"
                  required
                  class="w-full rounded-xl border-2 border-neutral-300 px-5 py-4 font-sans
                         focus:outline-none focus:ring-3 focus:ring-blue-500/30 focus:border-blue-500
                         transition-all duration-300 hover:border-neutral-400 resize-y min-h-[300px]"
                  placeholder="Escribe el contenido completo de la noticia aquí. Puedes usar formato básico como **negrita** o *cursiva*..."
                ></textarea>
                <div class="flex justify-between mt-2">
                  <span class="text-xs text-neutral-400">Soporta formato Markdown básico</span>
                  <span id="content-counter" class="text-xs text-neutral-400">0 caracteres</span>
                </div>
              </div>

              <!-- Imagen Destacada -->
              <div class="mb-10">
                <div class="flex items-center justify-between mb-3">
                  <label class="block text-sm font-semibold text-neutral-900">
                    <span class="flex items-center">
                      Imagen destacada
                    </span>
                    <span class="text-xs text-neutral-500 font-normal">Imagen principal de la noticia (recomendado)</span>
                  </label>
                  <button
                    type="button"
                    id="image-help"
                    class="text-xs text-blue-600 hover:text-blue-800 flex items-center"
                  >
                    <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Recomendaciones
                  </button>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div class="space-y-4">
                    <div>
                      <input
                        type="url"
                        name="image_url"
                        placeholder="https://ejemplo.com/imagen.jpg"
                        class="w-full rounded-xl border-2 border-neutral-300 px-5 py-3.5
                               focus:outline-none focus:ring-3 focus:ring-blue-500/30 focus:border-blue-500
                               transition-all duration-300 hover:border-neutral-400"
                      />
                      <p class="text-xs text-neutral-400 mt-2">
                        URL completa de la imagen (JPG, PNG, WebP)
                      </p>
                    </div>
                    
                    <button
                      type="button"
                      id="upload-image-btn"
                      class="w-full inline-flex items-center justify-center px-6 py-3.5 bg-gradient-to-r from-neutral-100 to-neutral-200 text-neutral-700 font-medium rounded-xl hover:from-white hover:to-neutral-300 transition-all duration-300 shadow-sm hover:shadow border border-neutral-300"
                    >
                      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                      </svg>
                      Subir desde dispositivo
                    </button>
                  </div>
                  
                  <div class="border-2 border-dashed border-neutral-300 rounded-xl p-6 text-center">
                    <div class="w-20 h-20 mx-auto mb-4 bg-gradient-to-br from-neutral-100 to-neutral-200 rounded-xl flex items-center justify-center">
                      <svg class="w-10 h-10 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                    </div>
                    <p class="text-sm text-neutral-600 mb-2">Vista previa de imagen</p>
                    <p class="text-xs text-neutral-500">La imagen aparecerá aquí</p>
                  </div>
                </div>
                
                <div id="image-preview-container" class="mt-4 hidden">
                  <div id="image-preview" class="max-w-md mx-auto rounded-xl overflow-hidden border border-neutral-300"></div>
                  <p class="text-xs text-neutral-500 mt-2 text-center">Vista previa de la imagen seleccionada</p>
                </div>
                
                <div class="mt-4 p-4 bg-gradient-to-r from-blue-50 to-indigo-50/50 rounded-xl border border-blue-200">
                  <p class="text-sm font-medium text-blue-900 mb-2">📸 Recomendaciones para la imagen</p>
                  <ul class="text-xs text-blue-800 space-y-1">
                    <li class="flex items-start">
                      <span class="mr-2">•</span>
                      <span>Formato: JPG, PNG o WebP</span>
                    </li>
                    <li class="flex items-start">
                      <span class="mr-2">•</span>
                      <span>Relación de aspecto: 16:9 (recomendado)</span>
                    </li>
                    <li class="flex items-start">
                      <span class="mr-2">•</span>
                      <span>Tamaño mínimo: 1200x675px</span>
                    </li>
                    <li class="flex items-start">
                      <span class="mr-2">•</span>
                      <span>Peso máximo: 2MB</span>
                    </li>
                  </ul>
                </div>
              </div>

              <!-- Configuración de Publicación -->
              <div class="mb-10" id="publishing-guide">
                <div class="flex items-center justify-between mb-3">
                  <label class="block text-sm font-semibold text-neutral-900">
                    <span class="flex items-center">
                      Configuración de publicación
                    </span>
                    <span class="text-xs text-neutral-500 font-normal">Controla cuándo y cómo se publica la noticia</span>
                  </label>
                </div>
                
                <div class="space-y-6">
                  <!-- Publicación inmediata -->
                  <div class="p-5 bg-gradient-to-r from-neutral-50 to-white rounded-xl border-2 border-neutral-300">
                    <div class="flex items-start justify-between">
                      <div class="flex-1">
                        <div class="flex items-center mb-2">
                          <div class="relative mr-3">
                            <input
                              type="radio"
                              name="publish_option"
                              id="publish_now"
                              value="now"
                              checked
                              class="sr-only peer"
                            />
                            <label
                              for="publish_now"
                              class="relative w-5 h-5 bg-white border-2 border-neutral-300 rounded-full peer-checked:border-blue-500 cursor-pointer transition-colors"
                            >
                              <span class="absolute inset-1 bg-blue-500 rounded-full scale-0 peer-checked:scale-100 transition-transform"></span>
                            </label>
                          </div>
                          <label for="publish_now" class="text-sm font-medium text-neutral-900 cursor-pointer">
                            Publicar inmediatamente
                          </label>
                        </div>
                        <p class="text-xs text-neutral-600 ml-8">
                          La noticia será visible públicamente tan pronto como la guardes.
                        </p>
                      </div>
                      <div class="px-3 py-1 bg-gradient-to-r from-green-100 to-emerald-100 text-green-800 text-xs font-semibold rounded-full border border-green-200">
                        Recomendado
                      </div>
                    </div>
                  </div>
                  
                  <!-- Guardar como borrador -->
                  <div class="p-5 bg-gradient-to-r from-neutral-50 to-white rounded-xl border-2 border-neutral-300">
                    <div class="flex items-start">
                      <div class="relative mr-3">
                        <input
                          type="radio"
                          name="publish_option"
                          id="publish_draft"
                          value="draft"
                          class="sr-only peer"
                        />
                        <label
                          for="publish_draft"
                          class="relative w-5 h-5 bg-white border-2 border-neutral-300 rounded-full peer-checked:border-blue-500 cursor-pointer transition-colors"
                        >
                          <span class="absolute inset-1 bg-blue-500 rounded-full scale-0 peer-checked:scale-100 transition-transform"></span>
                        </label>
                      </div>
                      <div class="flex-1">
                        <label for="publish_draft" class="text-sm font-medium text-neutral-900 cursor-pointer">
                          Guardar como borrador
                        </label>
                        <p class="text-xs text-neutral-600 mt-1">
                          La noticia se guardará pero no será visible públicamente hasta que decidas publicarla.
                        </p>
                      </div>
                    </div>
                  </div>
                  
                  <!-- Programar publicación -->
                  <div class="p-5 bg-gradient-to-r from-neutral-50 to-white rounded-xl border-2 border-neutral-300">
                    <div class="flex items-start">
                      <div class="relative mr-3">
                        <input
                          type="radio"
                          name="publish_option"
                          id="publish_schedule"
                          value="schedule"
                          class="sr-only peer"
                        />
                        <label
                          for="publish_schedule"
                          class="relative w-5 h-5 bg-white border-2 border-neutral-300 rounded-full peer-checked:border-blue-500 cursor-pointer transition-colors"
                        >
                          <span class="absolute inset-1 bg-blue-500 rounded-full scale-0 peer-checked:scale-100 transition-transform"></span>
                        </label>
                      </div>
                      <div class="flex-1">
                        <label for="publish_schedule" class="text-sm font-medium text-neutral-900 cursor-pointer">
                          Programar publicación
                        </label>
                        <p class="text-xs text-neutral-600 mt-1">
                          Programa la publicación para una fecha y hora específica.
                        </p>
                        <div id="schedule-fields" class="mt-3 space-y-3 hidden">
                          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <div>
                              <label class="block text-xs font-medium text-neutral-700 mb-1">
                                Fecha de publicación
                              </label>
                              <input
                                type="date"
                                id="schedule_date"
                                class="w-full rounded-lg border border-neutral-300 px-3 py-2 text-sm"
                              />
                            </div>
                            <div>
                              <label class="block text-xs font-medium text-neutral-700 mb-1">
                                Hora de publicación
                              </label>
                              <input
                                type="time"
                                id="schedule_time"
                                class="w-full rounded-lg border border-neutral-300 px-3 py-2 text-sm"
                              />
                            </div>
                          </div>
                          <p class="text-xs text-neutral-500">
                            La noticia se publicará automáticamente en la fecha y hora especificadas.
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Controles Finales -->
              <div class="pt-8 border-t border-neutral-200">
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                  <div class="flex items-center space-x-4">
                    <div class="hidden sm:flex items-center space-x-2 text-sm text-neutral-500">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      <span>Última vista previa: --</span>
                    </div>
                  </div>

                  <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                    <button
                      type="button"
                      id="preview-btn"
                      class="inline-flex items-center px-6 py-3.5 bg-gradient-to-r from-neutral-100 to-neutral-200 text-neutral-700 font-medium rounded-xl hover:from-white hover:to-neutral-300 transition-all duration-300 shadow-sm hover:shadow border border-neutral-300"
                    >
                      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                      </svg>
                      Vista Previa
                    </button>
                    
                    <button
                      type="submit"
                      id="submit-btn"
                      class="inline-flex items-center px-8 py-3.5 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-xl hover:from-blue-700 hover:to-indigo-700 transition-all duration-300 shadow-xl shadow-blue-500/30 hover:shadow-2xl hover:shadow-blue-500/50 hover:scale-105"
                    >
                      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      Crear Noticia
                    </button>
                  </div>
                </div>
              </div>

              <!-- Mensajes de Estado -->
              <div id="form-messages" class="mt-6 space-y-3"></div>
            </form>
          </div>
        </div>

        <!-- Panel Lateral -->
        <div class="space-y-8">
          <!-- Guía Rápida -->
          <div class="bg-white rounded-2xl border border-neutral-200/80 shadow-xl shadow-neutral-200/30 overflow-hidden">
            <div class="px-6 py-5 border-b border-neutral-200 bg-gradient-to-r from-white to-neutral-50">
              <h4 class="text-lg font-bold text-neutral-900">Guía Rápida</h4>
            </div>
            <div class="p-6">
              <div class="space-y-5">
                <div class="flex items-start space-x-3">
                  <div class="flex-shrink-0">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-100 to-indigo-100 flex items-center justify-center">
                      <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                    </div>
                  </div>
                  <div>
                    <h5 class="text-sm font-semibold text-neutral-900">Título atractivo</h5>
                    <p class="text-xs text-neutral-600 mt-1">Usa un título claro y descriptivo que capture la atención.</p>
                  </div>
                </div>
                
                <div class="flex items-start space-x-3">
                  <div class="flex-shrink-0">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-green-100 to-emerald-100 flex items-center justify-center">
                      <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                    </div>
                  </div>
                  <div>
