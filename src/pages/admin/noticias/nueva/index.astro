- **Inscripción:** [Cómo inscribirse]
- **Cupo:** [Límite de participantes si aplica]
- **Fecha límite:** [Fecha límite de inscripción]

### 🚗 Cómo Llegar
[Instrucciones para llegar al lugar del evento]

### 📋 Requisitos de Participación
- [Requisito 1]
- [Requisito 2]
- [Requisito 3]

### 🤝 Patrocinadores y Colaboradores
[Agradecimientos y reconocimientos]

### ❓ Más Información
Para consultas, contactar a [Persona Responsable] al [Teléfono/Email]`
        }
      };

      const selected = templates[template];
      if (selected) {
        const form = document.getElementById('news-form');
        form.title.value = selected.title;
        form.excerpt.value = selected.excerpt;
        form.content.value = selected.content;
        
        // Actualizar contadores
        updateCounter('title-counter', selected.title.length, 120);
        updateCounter('excerpt-counter', selected.excerpt.length, 300);
        updateCounter('content-counter', selected.content.length);
        
        // Actualizar estado
        formData.title = selected.title;
        formData.excerpt = selected.excerpt;
        formData.content = selected.content;
        
        showNotification('success', `Plantilla "${template}" aplicada. Recuerda personalizar los datos.`);
      }
    }

    function validateForm() {
      const form = document.getElementById('news-form');
      
      // Validar título
      if (!form.title.value.trim()) {
        showFormMessage('error', 'El título es obligatorio');
        form.title.focus();
        return false;
      }
      
      if (form.title.value.trim().length < 10) {
        showFormMessage('error', 'El título debe tener al menos 10 caracteres');
        form.title.focus();
        return false;
      }
      
      // Validar extracto
      if (!form.excerpt.value.trim()) {
        showFormMessage('error', 'El extracto es obligatorio');
        form.excerpt.focus();
        return false;
      }
      
      if (form.excerpt.value.trim().length < 50) {
        showFormMessage('error', 'El extracto debe tener al menos 50 caracteres');
        form.excerpt.focus();
        return false;
      }
      
      // Validar contenido
      if (!form.content.value.trim()) {
        showFormMessage('error', 'El contenido es obligatorio');
        form.content.focus();
        return false;
      }
      
      if (form.content.value.trim().length < 100) {
        showFormMessage('error', 'El contenido debe tener al menos 100 caracteres');
        form.content.focus();
        return false;
      }
      
      // Validar fecha programada si aplica
      if (formData.publish_option === 'schedule') {
        const date = document.getElementById('schedule_date').value;
        const time = document.getElementById('schedule_time').value;
        
        if (!date || !time) {
          showFormMessage('error', 'Debes especificar fecha y hora para la publicación programada');
          return false;
        }
        
        const scheduledDate = new Date(`${date}T${time}`);
        const now = new Date();
        
        if (scheduledDate <= now) {
          showFormMessage('error', 'La fecha programada debe ser futura');
          return false;
        }
      }
      
      return true;
    }

    function prepareNewsData(profile) {
      const form = document.getElementById('news-form');
      const publishOption = formData.publish_option;
      
      const data = {
        club_id: profile.club_id,
        title: form.title.value.trim(),
        excerpt: form.excerpt.value.trim(),
        content: form.content.value.trim(),
        image_url: form.image_url.value.trim() || null,
        author_id: currentUser.id,
        published: publishOption === 'now',
        published_at: publishOption === 'now' ? new Date().toISOString() : null
      };
      
      // Si es programada, calcular fecha de publicación
      if (publishOption === 'schedule') {
        const date = document.getElementById('schedule_date').value;
        const time = document.getElementById('schedule_time').value;
        data.published = false;
        data.scheduled_at = `${date}T${time}`;
      }
      
      return data;
    }

    async function loadUserStats(profile) {
      try {
        // Contar noticias creadas este mes
        const startOfMonth = new Date();
        startOfMonth.setDate(1);
        startOfMonth.setHours(0, 0, 0, 0);
        
        const { count, error } = await supabase
          .from('news')
          .select('*', { count: 'exact', head: true })
          .eq('club_id', profile.club_id)
          .eq('author_id', currentUser.id)
          .gte('created_at', startOfMonth.toISOString());
        
        if (!error) {
          document.getElementById('created-count').textContent = count || 0;
        }
      } catch (error) {
        console.error('Error cargando estadísticas:', error);
      }
    }

    function showSuccessModal(newsId, isPublished) {
      const modal = document.getElementById('success-modal');
      const message = document.getElementById('success-message');
      
      if (isPublished) {
        message.textContent = '¡La noticia ha sido publicada exitosamente y ya está disponible para todos los usuarios!';
      } else {
        message.textContent = '¡La noticia ha sido guardada como borrador exitosamente! Puedes publicarla cuando lo desees.';
      }
      
      // Configurar botones del modal
      document.getElementById('modal-view').onclick = () => {
        window.open(`/noticias/${newsId}`, '_blank');
        hideSuccessModal();
        setTimeout(() => window.location.href = "/admin/noticias", 500);
      };
      
      document.getElementById('modal-list').onclick = () => {
        hideSuccessModal();
        window.location.href = "/admin/noticias";
      };
      
      // Mostrar modal
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function hideSuccessModal() {
      document.getElementById('success-modal').classList.add('hidden');
      document.body.style.overflow = 'auto';
    }

    function showFormMessage(type, text) {
      const messagesContainer = document.getElementById('form-messages');
      const messageDiv = document.createElement('div');
      
      const colors = {
        success: { bg: 'bg-gradient-to-r from-green-50 to-emerald-50', border: 'border-green-200', text: 'text-green-800' },
        error: { bg: 'bg-gradient-to-r from-red-50 to-pink-50', border: 'border-red-200', text: 'text-red-800' },
        info: { bg: 'bg-gradient-to-r from-blue-50 to-indigo-50', border: 'border-blue-200', text: 'text-blue-800' }
      };
      
      messageDiv.className = `p-4 rounded-xl border ${colors[type].bg} ${colors[type].border} ${colors[type].text}`;
      messageDiv.innerHTML = `
        <div class="flex items-center">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            ${
              type === 'success' 
                ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>'
                : type === 'error'
                ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M9 21a9 9 0 1118 0 9 9 0 01-18 0z"/>'
                : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>'
            }
          </svg>
          <span class="font-medium">${text}</span>
        </div>
      `;
      
      messagesContainer.appendChild(messageDiv);
      
      if (type === 'success') {
        setTimeout(() => messageDiv.remove(), 5000);
      }
    }

    function showNotification(type, message, duration = 5000) {
      const notification = document.createElement('div');
      const colors = {
        success: { bg: 'from-green-500 to-emerald-500', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
        error: { bg: 'from-red-500 to-pink-500', icon: 'M12 9v2m0 4h.01M9 21a9 9 0 1118 0 9 9 0 01-18 0z' },
        info: { bg: 'from-blue-500 to-indigo-500', icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
        warning: { bg: 'from-amber-500 to-yellow-500', icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.856-.833-2.624 0L4.732 16.5c-.77.833.192 2.5 1.732 2.5' }
      };
      
      notification.className = `fixed top-6 right-6 z-50 max-w-md transform transition-all duration-500 translate-x-full`;
      notification.innerHTML = `
        <div class="bg-white rounded-xl shadow-2xl border border-neutral-200 overflow-hidden">
          <div class="flex items-start p-4">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 rounded-full bg-gradient-to-r ${colors[type].bg} flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${colors[type].icon}"/>
                </svg>
              </div>
            </div>
            <div class="ml-4 flex-1">
              <p class="text-sm font-medium text-neutral-900">${message}</p>
            </div>
            <button class="ml-4 flex-shrink-0 text-neutral-400 hover:text-neutral-600 transition-colors" onclick="this.parentElement.parentElement.parentElement.remove()">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
          <div class="h-1 w-full bg-gradient-to-r ${colors[type].bg}"></div>
        </div>
      `;
      
      document.body.appendChild(notification);
      
      // Animar entrada
      requestAnimationFrame(() => {
        notification.classList.remove('translate-x-full');
      });
      
      // Auto-eliminar
      setTimeout(() => {
        notification.classList.add('translate-x-full');
        setTimeout(() => notification.remove(), 500);
      }, duration);
    }
  </script>
</BaseLayout>