  <script type="module">
    import { supabase } from "../../../../lib/supabaseClient";

    // Estado global
    let currentUser = null;
    let currentProfile = null;
    let formData = {
      title: '',
      excerpt: '',
      content: '',
      image_url: '',
      publish_option: 'now'
    };

    // Inicialización
    document.addEventListener('DOMContentLoaded', async () => {
      try {
        // Verificar sesión
        const { data: sessionData, error: sessionError } = await supabase.auth.getSession();
        if (sessionError || !sessionData.session) {
          window.location.href = "/admin?error=session_expired";
          return;
        }

        currentUser = sessionData.session.user;

        // Verificar permisos
        const { data: profile, error: profileError } = await supabase
          .from("profiles")
          .select("role, club_id, full_name, avatar_url")
          .eq("id", currentUser.id)
          .single();

        if (profileError || !profile || !["admin", "cronica", "editor"].includes(profile.role)) {
          showNotification('error', 'No tienes permisos para crear noticias');
          setTimeout(() => window.location.href = "/admin/dashboard", 2000);
          return;
        }

        currentProfile = profile;

        // Configurar formulario
        setupForm(currentProfile);

        // Cargar estadísticas del usuario
        await loadUserStats(currentProfile);

        // Configurar logout
        document.getElementById('logout').addEventListener('click', async () => {
          const confirmExit = confirm('¿Estás seguro de querer salir? Los cambios no guardados se perderán.');
          if (!confirmExit) return;
          await supabase.auth.signOut();
          window.location.href = "/admin";
        });

      } catch (error) {
        console.error('Error de inicialización:', error);
        showNotification('error', 'Error al cargar el creador de noticias');
      }
    });

    function setupForm(profile) {
      const form = document.getElementById('news-form');
      const titleInput = form.querySelector('input[name="title"]');
      const excerptInput = form.querySelector('textarea[name="excerpt"]');
      const contentInput = form.querySelector('textarea[name="content"]');
      const imageInput = form.querySelector('input[name="image_url"]');
      const previewBtn = document.getElementById('preview-btn');
      const submitBtn = document.getElementById('submit-btn');
      const uploadImageBtn = document.getElementById('upload-image-btn');
      const imageHelpBtn = document.getElementById('image-help');
      const publishOptions = form.querySelectorAll('input[name="publish_option"]');
      const scheduleFields = document.getElementById('schedule-fields');
      const templateButtons = document.querySelectorAll('[data-template]');
      const messagesContainer = document.getElementById('form-messages');

      // Contadores de caracteres
      titleInput.addEventListener('input', (e) => {
        formData.title = e.target.value;
        updateCounter('title-counter', e.target.value.length, 120);
      });

      excerptInput.addEventListener('input', (e) => {
        formData.excerpt = e.target.value;
        updateCounter('excerpt-counter', e.target.value.length, 300);
      });

      contentInput.addEventListener('input', (e) => {
        formData.content = e.target.value;
        updateCounter('content-counter', e.target.value.length);
      });

      imageInput.addEventListener('input', (e) => {
        formData.image_url = e.target.value;
        if (e.target.value) {
          showImagePreview(e.target.value);
        }
      });

      // Vista previa de imagen
      function showImagePreview(url) {
        const container = document.getElementById('image-preview-container');
        const preview = document.getElementById('image-preview');
        
        preview.innerHTML = `
          <div class="relative">
            <img 
              src="${url}" 
              alt="Vista previa" 
              class="w-full h-48 object-cover rounded-xl"
              onerror="this.onerror=null; this.src='data:image/svg+xml;base64,'"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-3">
              <p class="text-xs text-white truncate">${url}</p>
            </div>
          </div>
        `;
        
        container.classList.remove('hidden');
      }

      // Botones de formato
      document.getElementById('format-bold').addEventListener('click', () => {
        insertTextAtCursor(contentInput, '**texto en negrita**');
      });

      document.getElementById('format-italic').addEventListener('click', () => {
        insertTextAtCursor(contentInput, '*texto en cursiva*');
      });

      document.getElementById('format-link').addEventListener('click', () => {
        const url = prompt('Ingresa la URL del enlace:');
        if (url) {
          const text = prompt('Ingresa el texto del enlace (opcional):', url);
          insertTextAtCursor(contentInput, `[${text || url}](${url})`);
        }
      });

      // Ayuda de imagen
      imageHelpBtn.addEventListener('click', () => {
        showNotification('info', 'Usa imágenes en formato JPG, PNG o WebP. Tamaño recomendado: 1200x675px');
      });

      // Subir imagen (placeholder)
      uploadImageBtn.addEventListener('click', () => {
        showNotification('info', 'Funcionalidad de subida de imágenes en desarrollo. Por ahora, usa una URL pública.');
      });

      // Opciones de publicación
      publishOptions.forEach(option => {
        option.addEventListener('change', (e) => {
          formData.publish_option = e.target.value;
          
          if (e.target.value === 'schedule') {
            scheduleFields.classList.remove('hidden');
          } else {
            scheduleFields.classList.add('hidden');
          }
          
          // Actualizar texto del botón de envío
          updateSubmitButtonText(e.target.value);
        });
      });

      // Plantillas rápidas
      templateButtons.forEach(button => {
        button.addEventListener('click', () => {
          const template = button.getAttribute('data-template');
          applyTemplate(template);
        });
      });

      // Vista previa
      previewBtn.addEventListener('click', () => {
        // Validar datos mínimos para vista previa
        if (!formData.title || !formData.content) {
          showFormMessage('error', 'Completa al menos el título y contenido para ver la vista previa');
          return;
        }
        
        // Crear objeto de vista previa temporal
        const previewData = {
          ...formData,
          id: 'preview',
          created_at: new Date().toISOString(),
          author: currentProfile.full_name || currentUser.email
        };
        
        // Guardar en sessionStorage para vista previa
        sessionStorage.setItem('news_preview', JSON.stringify(previewData));
        
        // Abrir en nueva pestaña
        window.open('/noticias/preview', '_blank');
      });

      // Envío del formulario
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Limpiar mensajes anteriores
        messagesContainer.innerHTML = '';
        
        // Validación
        if (!validateForm()) {
          return;
        }
        
        // Preparar datos
        const newsData = prepareNewsData(profile);
        
        // Deshabilitar botón y mostrar estado
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
          <div class="inline-block animate-spin rounded-full h-5 w-5 border-b-2 border-white mr-2"></div>
          Creando noticia...
        `;
        
        try {
          // Insertar en Supabase
          const { data, error } = await supabase
            .from("news")
            .insert(newsData)
            .select()
            .single();
          
          if (error) throw error;
          
          // Mostrar modal de éxito
          showSuccessModal(data.id, formData.publish_option === 'now');
          
        } catch (error) {
          console.error('Error creando noticia:', error);
          showFormMessage('error', `Error al crear la noticia: ${error.message}`);
          showNotification('error', 'Error al guardar la noticia');
        } finally {
          // Restaurar botón
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
        }
      });

      // Inicializar contadores
      updateCounter('title-counter', titleInput.value.length, 120);
      updateCounter('excerpt-counter', excerptInput.value.length, 300);
      updateCounter('content-counter', contentInput.value.length);
    }

    function updateCounter(elementId, length, max = null) {
      const element = document.getElementById(elementId);
      if (max) {
        element.textContent = `${length}/${max}`;
        element.className = length > max * 0.9 ? 
          'text-xs text-amber-600' : 
          'text-xs text-neutral-400';
      } else {
        element.textContent = `${length.toLocaleString()} caracteres`;
      }
    }

    function insertTextAtCursor(textarea, text) {
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const selectedText = textarea.value.substring(start, end);
      
      const newText = text.replace('texto', selectedText || 'texto');
      textarea.value = textarea.value.substring(0, start) + 
                       newText + 
                       textarea.value.substring(end);
      
      // Posicionar cursor después del texto insertado
      const newCursorPos = start + newText.length;
      textarea.setSelectionRange(newCursorPos, newCursorPos);
      textarea.focus();
      
      // Actualizar estado
      formData.content = textarea.value;
      updateCounter('content-counter', textarea.value.length);
      
      // Disparar evento input
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
    }

    function updateSubmitButtonText(option) {
      const submitBtn = document.getElementById('submit-btn');
      const icon = `<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
      </svg>`;
      
      switch(option) {
        case 'now':
          submitBtn.innerHTML = `${icon}Publicar Noticia`;
          break;
        case 'draft':
          submitBtn.innerHTML = `${icon}Guardar Borrador`;
          break;
        case 'schedule':
          submitBtn.innerHTML = `${icon}Programar Noticia`;
          break;
      }
    }

    function applyTemplate(template) {
      const templates = {
