---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Gestión de Patrocinadores · Administración">
  <div class="min-h-screen bg-neutral-50">

    <!-- HEADER -->
    <header class="bg-white shadow-sm border-b border-neutral-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <a
            href="/admin/dashboard"
            class="text-neutral-600 hover:text-neutral-900 transition-colors p-2 hover:bg-neutral-100 rounded-lg flex items-center space-x-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            <span class="hidden sm:inline text-sm font-medium">Panel Principal</span>
          </a>
          <div class="h-6 w-px bg-neutral-200"></div>
          <div>
            <h1 class="font-semibold text-neutral-900">Gestión de Patrocinadores</h1>
            <p class="text-xs text-neutral-500">Empresas colaboradoras del club</p>
          </div>
        </div>

        <div class="flex items-center space-x-6">
          <div class="hidden md:flex items-center space-x-3 text-sm">
            <div class="h-2 w-2 bg-green-500 rounded-full"></div>
            <span class="text-neutral-600">Sesión Activa</span>
          </div>

          <a
            href="/admin/patrocinadores/nuevo"
            class="inline-flex items-center px-5 py-2.5 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-all shadow-sm"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 4v16m8-8H4" />
            </svg>
            Nuevo Patrocinador
          </a>

          <button
            id="logout"
            class="px-4 py-2 text-sm font-medium text-neutral-700 hover:text-red-700 hover:bg-red-50 rounded-lg transition-colors flex items-center space-x-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span>Cerrar Sesión</span>
          </button>
        </div>
      </div>
    </header>

    <!-- CONTENIDO -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

      <!-- MÉTRICAS -->
      <div class="mb-10">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between">
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-neutral-900">Patrocinadores</h2>
            <p class="text-neutral-600 mt-2">
              Gestiona las empresas colaboradoras y su visibilidad
            </p>
          </div>

          <div class="mt-6 lg:mt-0 flex items-center space-x-6">
            <div class="text-right">
              <p class="text-sm text-neutral-500">Activos</p>
              <p id="active-count" class="text-2xl font-bold text-green-600">--</p>
            </div>
            <div class="text-right">
              <p class="text-sm text-neutral-500">Inactivos</p>
              <p id="inactive-count" class="text-2xl font-bold text-neutral-500">--</p>
            </div>
          </div>
        </div>
      </div>

      <!-- TOOLBAR -->
      <div class="mb-6">
        <div class="bg-white rounded-xl border border-neutral-200 shadow-sm p-4 flex flex-col sm:flex-row gap-4 justify-between">
          <div class="flex items-center space-x-2">
            <button data-filter="all" class="filter-btn bg-white border border-neutral-200 shadow-sm px-3 py-1.5 rounded-md">
              Todos
            </button>
            <button data-filter="active" class="filter-btn px-3 py-1.5 text-neutral-600 hover:text-neutral-900">
              Activos
            </button>
            <button data-filter="inactive" class="filter-btn px-3 py-1.5 text-neutral-600 hover:text-neutral-900">
              Inactivos
            </button>
          </div>

          <div class="relative w-full sm:w-64">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-neutral-400"
              fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              id="search-input"
              placeholder="Buscar patrocinador..."
              class="w-full pl-10 pr-4 py-2 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
            />
          </div>
        </div>
      </div>

      <!-- GRID -->
      <div id="sponsor-grid" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>

      <!-- EMPTY -->
      <div id="empty-state" class="hidden text-center py-16 bg-white rounded-xl border border-dashed border-neutral-300">
        <svg class="w-20 h-20 text-neutral-300 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h4 class="text-xl font-semibold text-neutral-900 mb-2">No hay patrocinadores</h4>
        <p class="text-neutral-600 max-w-md mx-auto mb-8">
          Añade patrocinadores para dar visibilidad a las empresas colaboradoras.
        </p>
        <a
          href="/admin/patrocinadores/nuevo"
          class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700"
        >
          Crear primer patrocinador
        </a>
      </div>

    </main>
  </div>

  <script type="module">
    import { supabase } from "../../../lib/supabaseClient";

    let sponsors = [];
    let filter = "all";

    document.addEventListener("DOMContentLoaded", async () => {
      const { data: sessionData } = await supabase.auth.getSession();
      if (!sessionData.session) {
        location.href = "/admin";
        return;
      }

      const user = sessionData.session.user;

      const { data: profile } = await supabase
        .from("profiles")
        .select("club_id")
        .eq("id", user.id)
        .single();

      const { data } = await supabase
        .from("sponsors")
        .select("*")
        .eq("club_id", profile.club_id)
        .order("created_at", { ascending: false });

      sponsors = data || [];
      updateCounts();
      renderSponsors();
      setupFilters();

      document.getElementById("logout").addEventListener("click", async () => {
        await supabase.auth.signOut();
        location.href = "/admin";
      });
    });

    function updateCounts() {
      document.getElementById("active-count").textContent =
        sponsors.filter(s => s.active).length;
      document.getElementById("inactive-count").textContent =
        sponsors.filter(s => !s.active).length;
    }

    function renderSponsors() {
      const grid = document.getElementById("sponsor-grid");
      const empty = document.getElementById("empty-state");

      let list = [...sponsors];

      if (filter === "active") list = list.filter(s => s.active);
      if (filter === "inactive") list = list.filter(s => !s.active);

      const q = document.getElementById("search-input").value.toLowerCase();
      if (q) list = list.filter(s => s.name.toLowerCase().includes(q));

      grid.innerHTML = "";

      if (!list.length) {
        grid.classList.add("hidden");
        empty.classList.remove("hidden");
        return;
      }

      empty.classList.add("hidden");
      grid.classList.remove("hidden");

      list.forEach(s => {
        const status = s.active
          ? `<span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-800">Activo</span>`
          : `<span class="px-2 py-1 text-xs rounded-full bg-neutral-200 text-neutral-700">Inactivo</span>`;

        const levelColor = {
          principal: "bg-yellow-100 text-yellow-800",
          oro: "bg-amber-100 text-amber-800",
          plata: "bg-neutral-200 text-neutral-800",
          bronce: "bg-orange-100 text-orange-800"
        }[s.level] || "bg-neutral-100 text-neutral-700";

        const card = document.createElement("div");
        card.className =
          "group bg-white rounded-xl border border-neutral-200 hover:shadow-lg transition-all duration-300 overflow-hidden";

        card.innerHTML = `
          <div class="p-5 flex flex-col h-full">
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1 min-w-0">
                <h4 class="font-semibold text-neutral-900 text-lg truncate group-hover:text-blue-600">
                  ${escapeHtml(s.name)}
                </h4>
                <span class="inline-block mt-1 px-2 py-1 text-xs rounded-full ${levelColor}">
                  ${s.level || "Sin nivel"}
                </span>
              </div>
              ${status}
            </div>

            <div class="flex items-center justify-center h-32 mb-4">
              <img src="${s.logo_url || "/placeholder.png"}" class="max-h-28 object-contain" />
            </div>

            <div class="mt-auto pt-4 border-t border-neutral-100 flex items-center justify-between">
              <a href="${s.website || "#"}" target="_blank" class="text-sm text-blue-600 hover:underline">
                Ver web
              </a>
              <div class="flex space-x-2">
                <a href="/admin/patrocinadores/editar/${s.id}" class="p-2 hover:bg-neutral-100 rounded-lg">
                  ✏️
                </a>
                <button class="p-2 hover:bg-red-50 rounded-lg text-red-600">
                  🗑
                </button>
              </div>
            </div>
          </div>
        `;

        grid.appendChild(card);
      });
    }

    function setupFilters() {
      document.querySelectorAll(".filter-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          filter = btn.dataset.filter;
          renderSponsors();
        });
      });

      document.getElementById("search-input").addEventListener("input", renderSponsors);
    }

    function escapeHtml(text) {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }
  </script>
</BaseLayout>
