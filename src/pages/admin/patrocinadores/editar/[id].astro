---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Editar Patrocinador · Administración">
  <div class="min-h-screen bg-gradient-to-br from-neutral-50 via-white to-blue-50/30">

    <!-- HEADER -->
    <header class="bg-white/95 backdrop-blur shadow border-b border-neutral-200 sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <a href="/admin/patrocinadores"
             class="p-2 rounded-xl hover:bg-neutral-100 transition">
            ←
          </a>
          <div>
            <h1 class="font-semibold text-neutral-900">Editar Patrocinador</h1>
            <p class="text-xs text-neutral-500">Actualizar información del colaborador</p>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" id="active-toggle" class="sr-only peer">
            <div class="w-12 h-6 bg-neutral-300 peer-checked:bg-green-600 rounded-full relative transition">
              <span class="absolute top-1 left-1 w-4 h-4 bg-white rounded-full transition peer-checked:translate-x-6"></span>
            </div>
            <span id="active-text" class="font-medium text-neutral-700">Inactivo</span>
          </label>

          <button id="logout"
            class="px-4 py-2 text-sm rounded-xl hover:bg-red-50 hover:text-red-700 transition">
            Cerrar sesión
          </button>
        </div>
      </div>
    </header>

    <!-- CONTENIDO -->
    <main class="max-w-5xl mx-auto px-6 py-10">

      <form id="sponsor-form" class="space-y-10">

        <!-- INFO PÚBLICA -->
        <div class="bg-white rounded-2xl border shadow-xl p-8">
          <h2 class="text-xl font-bold mb-6">Información pública</h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="font-medium">Nombre *</label>
              <input name="name" required class="w-full mt-1 rounded-xl border px-4 py-3"/>
            </div>

            <div>
              <label class="font-medium">Nivel</label>
              <select name="level" class="w-full mt-1 rounded-xl border px-4 py-3">
                <option value="principal">Principal</option>
                <option value="oro">Oro</option>
                <option value="plata">Plata</option>
                <option value="bronce">Bronce</option>
              </select>
            </div>

            <div class="md:col-span-2">
              <label class="font-medium">Descripción</label>
              <textarea name="description" rows="4"
                class="w-full mt-1 rounded-xl border px-4 py-3"></textarea>
            </div>

            <div>
              <label class="font-medium">Logo (URL)</label>
              <input name="logo_url" type="url"
                class="w-full mt-1 rounded-xl border px-4 py-3"/>
            </div>

            <div>
              <label class="font-medium">Web</label>
              <input name="website" type="url"
                class="w-full mt-1 rounded-xl border px-4 py-3"/>
            </div>
          </div>
        </div>

        <!-- CONTACTO -->
        <div class="bg-white rounded-2xl border shadow-xl p-8">
          <h2 class="text-xl font-bold mb-6">Contacto</h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <input name="contact_name" placeholder="Persona responsable"
              class="rounded-xl border px-4 py-3"/>
            <input name="contact_role" placeholder="Cargo"
              class="rounded-xl border px-4 py-3"/>
            <input name="contact_email" placeholder="Email"
              class="rounded-xl border px-4 py-3"/>
            <input name="contact_phone" placeholder="Teléfono"
              class="rounded-xl border px-4 py-3"/>
          </div>
        </div>

        <!-- INTERNO -->
        <div class="bg-neutral-50 rounded-2xl border p-8">
          <h2 class="text-xl font-bold mb-6">Información interna</h2>

          <textarea name="internal_notes" rows="4"
            placeholder="Notas internas del club..."
            class="w-full rounded-xl border px-4 py-3"></textarea>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-4">
            <input type="date" name="contract_start" class="rounded-xl border px-4 py-3"/>
            <input type="date" name="contract_end" class="rounded-xl border px-4 py-3"/>
            <input type="number" name="annual_amount"
              placeholder="Importe anual (€)"
              class="rounded-xl border px-4 py-3"/>
          </div>
        </div>

        <!-- ACCIONES -->
        <div class="flex justify-between items-center">
          <button type="button" id="delete-btn"
            class="px-6 py-3 rounded-xl border border-red-300 text-red-600 hover:bg-red-50">
            Eliminar patrocinador
          </button>

          <div class="flex gap-4">
            <a href="/admin/patrocinadores"
              class="px-6 py-3 rounded-xl border">
              Cancelar
            </a>
            <button type="submit"
              class="px-8 py-3 rounded-xl bg-blue-600 text-white font-semibold">
              Guardar cambios
            </button>
          </div>
        </div>

        <div id="form-messages"></div>
      </form>
    </main>
  </div>

  <script type="module">
    import { supabase } from "../../../../lib/supabaseClient";

    const sponsorId = window.location.pathname.split("/").pop();
    const form = document.getElementById("sponsor-form");
    const activeToggle = document.getElementById("active-toggle");
    const activeText = document.getElementById("active-text");

    let clubId = null;

    document.addEventListener("DOMContentLoaded", async () => {
      const { data: session } = await supabase.auth.getSession();
      if (!session.session) return location.href = "/admin";

      const { data: profile } = await supabase
        .from("profiles")
        .select("club_id")
        .eq("id", session.session.user.id)
        .single();

      clubId = profile.club_id;

      const { data: sponsor, error } = await supabase
        .from("sponsors")
        .select("*")
        .eq("id", sponsorId)
        .eq("club_id", clubId)
        .single();

      if (error || !sponsor) {
        alert("Patrocinador no encontrado");
        return location.href = "/admin/patrocinadores";
      }

      // rellenar
      Object.keys(sponsor).forEach(k => {
        if (form[k]) form[k].value = sponsor[k] ?? "";
      });

      activeToggle.checked = sponsor.active;
      updateActiveText();
    });

    activeToggle.addEventListener("change", updateActiveText);

    function updateActiveText() {
      activeText.textContent = activeToggle.checked ? "Activo" : "Inactivo";
    }

    form.addEventListener("submit", async e => {
      e.preventDefault();

      const data = Object.fromEntries(new FormData(form).entries());

      const { error } = await supabase
        .from("sponsors")
        .update({
          ...data,
          active: activeToggle.checked,
          updated_at: new Date().toISOString()
        })
        .eq("id", sponsorId)
        .eq("club_id", clubId);

      if (error) {
        alert(error.message);
      } else {
        location.href = "/admin/patrocinadores";
      }
    });

    document.getElementById("delete-btn").addEventListener("click", async () => {
      if (!confirm("¿Eliminar este patrocinador definitivamente?")) return;

      await supabase
        .from("sponsors")
        .delete()
        .eq("id", sponsorId)
        .eq("club_id", clubId);

      location.href = "/admin/patrocinadores";
    });

    document.getElementById("logout").addEventListener("click", async () => {
      await supabase.auth.signOut();
      location.href = "/admin";
    });
  </script>
</BaseLayout>
