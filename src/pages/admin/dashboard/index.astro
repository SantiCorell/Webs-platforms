---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Panel de Control · Administración">
  <div class="min-h-screen bg-neutral-50">

    <!-- Cabecera -->
    <header class="bg-white shadow-sm border-b border-neutral-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="h-8 w-8 bg-blue-600 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <div>
            <h1 class="text-lg font-semibold text-neutral-900">Panel de Administración</h1>
            <p class="text-xs text-neutral-500">Club Deportivo · Área Privada</p>
          </div>
        </div>

        <div class="flex items-center space-x-4">
          <span class="text-sm text-neutral-600 hidden md:inline">Sesión activa</span>
          <button
            id="logout"
            class="px-4 py-2 text-sm font-medium text-neutral-700 hover:text-red-700 hover:bg-red-50 rounded-lg transition-colors duration-200 flex items-center space-x-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            <span>Cerrar Sesión</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

      <!-- Cabecera del Dashboard -->
      <div class="mb-10">
        <div class="flex flex-col md:flex-row md:items-end justify-between md:space-x-6">
          <div class="flex-1">
            <div class="flex items-center space-x-3 mb-3">
              <h2 class="text-2xl md:text-3xl font-bold text-neutral-900">Bienvenido al panel de control</h2>
              <span class="text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded-full font-medium">Admin</span>
            </div>
            <p class="text-neutral-600 max-w-2xl">
              Desde aquí podrás gestionar todos los contenidos del club. Cada sección está diseñada para facilitar la administración diaria.
            </p>
            <div class="mt-4 p-4 bg-blue-50 rounded-lg border border-blue-100 inline-block">
              <p class="text-sm text-blue-800 flex items-center">
                <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Conectado como: <span id="user-email" class="font-semibold ml-1"></span>
              </p>
            </div>
          </div>

          <div class="mt-6 md:mt-0">
            <a
              href="/"
              target="_blank"
              class="inline-flex items-center px-5 py-3 bg-white border border-neutral-300 text-neutral-700 font-medium rounded-lg hover:bg-neutral-50 hover:border-neutral-400 transition-all duration-200 shadow-sm hover:shadow"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
              Ver sitio público
            </a>
          </div>
        </div>
      </div>

      <!-- Estado del Sistema -->
      <div class="mb-10">
        <div class="bg-gradient-to-r from-blue-50 to-white border border-blue-100 rounded-xl p-6 shadow-sm">
          <div class="flex flex-col md:flex-row md:items-center justify-between">
            <div class="mb-4 md:mb-0">
              <div class="flex items-center mb-2">
                <div class="h-3 w-3 bg-green-500 rounded-full mr-2 animate-pulse"></div>
                <span class="text-sm font-medium text-green-700">SISTEMA OPERATIVO</span>
              </div>
              <h3 class="text-xl font-bold text-neutral-900">Portal activo y funcionando</h3>
              <p class="text-neutral-600 mt-1">Todos los servicios están operativos y respondiendo correctamente.</p>
              <div class="mt-4 flex items-center text-sm text-neutral-500">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Última actualización: hace 2 días
              </div>
            </div>
            <div class="flex space-x-3">
              <div class="text-center p-4 bg-white rounded-lg border">
                <div class="text-2xl font-bold text-blue-600">24/7</div>
                <div class="text-xs text-neutral-500 mt-1">Disponibilidad</div>
              </div>
              <div class="text-center p-4 bg-white rounded-lg border">
                <div class="text-2xl font-bold text-green-600">100%</div>
                <div class="text-xs text-neutral-500 mt-1">Rendimiento</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Módulos de Administración -->
      <div>
        <h3 class="text-lg font-semibold text-neutral-900 mb-6 flex items-center">
          <svg class="w-5 h-5 mr-2 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
          Módulos de Gestión
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

          <!-- Módulo Principal: Noticias -->
          <a
            href="/admin/noticias"
            class="group bg-white border-l-4 border-blue-600 rounded-lg shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-neutral-200 hover:border-blue-200"
          >
            <div class="p-6">
              <div class="flex items-start justify-between mb-4">
                <div class="p-3 bg-blue-50 rounded-lg group-hover:bg-blue-100 transition-colors">
                  <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                  </svg>
                </div>
                <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-2 py-1 rounded">PRINCIPAL</span>
              </div>
              <h4 class="text-lg font-semibold text-neutral-900 group-hover:text-blue-700 mb-2">Gestión de Noticias</h4>
              <p class="text-sm text-neutral-600 mb-4">
                Publica comunicados oficiales, novedades y actualizaciones del club. Control total sobre contenidos y visibilidad.
              </p>
              <div class="flex items-center text-sm text-blue-600 font-medium">
                <span>Acceder al módulo</span>
                <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </div>
            </div>
          </a>

          <!-- Galería Multimedia -->
          <a
            href="/admin/galeria"
            class="group bg-white rounded-lg shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-neutral-200 hover:border-purple-200"
          >
            <div class="p-6">
              <div class="p-3 bg-purple-50 rounded-lg group-hover:bg-purple-100 transition-colors w-fit mb-4">
                <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
              <h4 class="text-lg font-semibold text-neutral-900 group-hover:text-purple-700 mb-2">Galería Multimedia</h4>
              <p class="text-sm text-neutral-600 mb-4">
                Administra álbumes fotográficos, organiza eventos visuales y gestiona el archivo multimedia del club.
              </p>
              <div class="text-xs text-neutral-500">Última subida: 15/Nov</div>
            </div>
          </a>

          <!-- Patrocinadores y Colaboradores -->
          <a
            href="/admin/patrocinadores"
            class="group bg-white rounded-lg shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-neutral-200 hover:border-green-200"
          >
            <div class="p-6">
              <div class="p-3 bg-green-50 rounded-lg group-hover:bg-green-100 transition-colors w-fit mb-4">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <h4 class="text-lg font-semibold text-neutral-900 group-hover:text-green-700 mb-2">Patrocinadores</h4>
              <p class="text-sm text-neutral-600 mb-4">
                Controla la visibilidad de colaboradores, actualiza logos y gestiona acuerdos de patrocinio activos.
              </p>
              <div class="flex items-center text-sm text-green-600 font-medium">
                <span>12 colaboradores activos</span>
              </div>
            </div>
          </a>

          <!-- Información del Club -->
          <a
            href="/admin/club"
            class="group bg-white rounded-lg shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-neutral-200 hover:border-orange-200"
          >
            <div class="p-6">
              <div class="p-3 bg-orange-50 rounded-lg group-hover:bg-orange-100 transition-colors w-fit mb-4">
                <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
              </div>
              <h4 class="text-lg font-semibold text-neutral-900 group-hover:text-orange-700 mb-2">Datos Institucionales</h4>
              <p class="text-sm text-neutral-600 mb-4">
                Información oficial del club, datos de contacto, ubicación y configuración institucional.
              </p>
              <div class="text-xs text-neutral-500">Información verificada</div>
            </div>
          </a>

          <!-- Gestión de Usuarios -->
          <a
            href="/admin/club/usuarios"
            class="group bg-white rounded-lg shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-neutral-200 hover:border-neutral-400 p-6"
          >
            <div class="text-center">
              <div class="inline-flex items-center justify-center w-12 h-12 bg-neutral-100 rounded-full mb-4">
                <svg class="w-6 h-6 text-neutral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197"/>
                </svg>
              </div>

              <h4 class="text-lg font-semibold text-neutral-900 group-hover:text-neutral-700 mb-2">
                Gestión de Usuarios
              </h4>

              <p class="text-sm text-neutral-600 mb-4">
                Control de permisos, roles de acceso y administración de cuentas de personal autorizado.
              </p>

              <div class="text-xs text-neutral-500">
                Acceso y roles del club
              </div>
            </div>
          </a>



          <!-- Próximos Módulos -->
          

        </div>
      </div>

      <!-- Pie del Dashboard -->
      <div class="mt-12 pt-6 border-t border-neutral-200">
        <div class="flex flex-col md:flex-row justify-between items-center text-sm text-neutral-500">
          <div>
            <p>Club Deportivo · Panel de Administración v2.1</p>
            <p class="mt-1">© 2024 · Todos los derechos reservados</p>
          </div>
          <div class="mt-4 md:mt-0">
            <p class="flex items-center">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Sesión iniciada hace 45 minutos
            </p>
          </div>
        </div>
      </div>

    </main>
  </div>

  <!-- Scripts de Gestión -->
  <script type="module">
    import { supabase } from "../../../lib/supabaseClient";

    // Verificar sesión activa
    const { data } = await supabase.auth.getSession();
    
    if (!data.session) {
      window.location.href = "/login?redirect=" + encodeURIComponent(window.location.pathname);
    } else {
      const emailEl = document.getElementById("user-email");
      if (emailEl) {
        emailEl.textContent = data.session.user.email;
      }
      
      // Registrar actividad
      await supabase
        .from('admin_logs')
        .insert([{
          user_id: data.session.user.id,
          action: 'login_dashboard',
          ip_address: await getClientIP()
        }]);
    }

    // Logout controlado
    document.getElementById("logout")?.addEventListener("click", async (e) => {
      e.preventDefault();
      
      if (confirm("¿Está seguro de que desea cerrar la sesión?")) {
        await supabase.auth.signOut();
        window.location.href = "/login";
      }
    });

    // Función auxiliar para obtener IP
    async function getClientIP() {
      try {
        const response = await fetch('https://api.ipify.org?format=json');
        const data = await response.json();
        return data.ip;
      } catch {
        return 'unknown';
      }
    }
  </script>
</BaseLayout>