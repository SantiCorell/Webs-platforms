---
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Acceso administración">
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-900 via-gray-800 to-black px-4">
    
    <div class="w-full max-w-md bg-gray-900 border border-gray-700 rounded-2xl shadow-2xl p-8">
      
      <h1 class="text-2xl font-semibold text-white mb-2">
        Acceso administración
      </h1>
      <p class="text-sm text-gray-400 mb-6">
        Inicia sesión para gestionar tu club
      </p>

      <form id="login-form" class="space-y-4">
        <input
          id="email"
          type="email"
          placeholder="Email"
          required
          class="w-full rounded-lg bg-gray-800 border border-gray-700 px-4 py-2 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-500"
        />

        <input
          id="password"
          type="password"
          placeholder="Contraseña"
          required
          class="w-full rounded-lg bg-gray-800 border border-gray-700 px-4 py-2 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-500"
        />

        <button
          id="login-btn"
          type="submit"
          class="w-full bg-orange-500 hover:bg-orange-600 text-black font-semibold py-2 rounded-lg transition disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Entrar
        </button>
      </form>

      <p id="error"
         class="text-sm text-red-400 mt-4 hidden"></p>
    </div>
  </div>

  <!-- Lógica -->
  <script type="module">
    import { supabase } from "@/lib/supabaseClient";

    const form = document.getElementById("login-form");
    const errorText = document.getElementById("error");
    const button = document.getElementById("login-btn");

    // 🔐 Si ya hay sesión → fuera de aquí
    const { data } = await supabase.auth.getSession();
    if (data.session) {
      window.location.href = "/admin";
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      errorText.classList.add("hidden");
      button.disabled = true;
      button.textContent = "Entrando...";

      const email = document.getElementById("email").value.trim();
      const password = document.getElementById("password").value;

      const { error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error) {
        errorText.textContent = "Credenciales incorrectas";
        errorText.classList.remove("hidden");
        button.disabled = false;
        button.textContent = "Entrar";
        return;
      }

      // ✅ Login OK
      window.location.href = "/admin";
    });
  </script>
</BaseLayout>
