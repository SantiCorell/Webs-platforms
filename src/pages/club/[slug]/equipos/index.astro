---
export const prerender = false;

import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ClubHeader from "../../../../components/ClubHeader.astro";

const { slug } = Astro.params;
const clubName = slug.replace("-", " ").toUpperCase();

// MOCK equipos
const teams = [
  { name: "Infantil A", coach: "Juan Pérez" },
  { name: "Cadete B", coach: "Carlos Ruiz" },
];
---
<BaseLayout title={`Equipos · ${clubName}`}>
  <ClubHeader clubName={clubName} slug={slug} />

  <section class="mt-8">
    <h1 class="text-2xl font-bold mb-6">Equipos</h1>

    <div class="grid gap-4 md:grid-cols-2">
      {teams.map(team => (
        <div class="bg-white p-4 rounded shadow-sm">
          <h2 class="font-semibold">{team.name}</h2>
          <p class="text-sm text-gray-600">Entrenador: {team.coach}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
