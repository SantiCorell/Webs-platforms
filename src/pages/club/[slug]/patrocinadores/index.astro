---
export const prerender = false;

import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ClubHeader from "../../../../components/ClubHeader.astro";
import { clubs } from "../../../../data/clubs";

const { slug } = Astro.params;
const club = clubs[slug];

// Mock sponsors (luego vendrán de CMS)
const mainSponsor = {
  name: "El Rumbo",
  logo: "/assets/logos/el-rumbo.png",
  url: "#",
};

const collaborators = [
  {
    name: "Empresa Local 1",
    logo: "/assets/logos/el-rumbo.png",
    url: "#",
  },
  {
    name: "Empresa Local 2",
    logo: "/assets/logos/el-rumbo.png",
    url: "#",
  },
];
---

<BaseLayout
  title={`Patrocinadores · ${club?.name ?? "Club"}`}
  color={club?.color}
>
  {club && (
    <>
      <!-- HEADER -->
      <ClubHeader
        clubName={club.name}
        slug={slug}
        logoUrl={club.logo}
      />

      <!-- CABECERA -->
      <section class="border-b border-gray-200 bg-white">
        <div class="max-w-7xl mx-auto px-6 py-12">
          <h1 class="text-3xl font-bold text-gray-900">
            Patrocinadores
          </h1>

          <p class="mt-4 max-w-3xl text-gray-600">
            Empresas y colaboradores que apoyan al {club.name}
            y contribuyen al desarrollo del deporte y del fútbol base.
          </p>
        </div>
      </section>

      <!-- PATROCINADOR PRINCIPAL -->
      {mainSponsor && (
        <section class="bg-gray-50 border-b border-gray-200">
          <div class="max-w-7xl mx-auto px-6 py-14 text-center">
            <p
              class="text-sm uppercase tracking-wide font-semibold mb-6"
              style="color: var(--club-color)"
            >
              Patrocinador principal
            </p>

            <a href={mainSponsor.url} target="_blank" class="inline-block">
              <img
                src={mainSponsor.logo}
                alt={mainSponsor.name}
                class="mx-auto h-28 object-contain"
              />
            </a>
          </div>
        </section>
      )}

      <!-- COLABORADORES -->
      <section class="bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-6 py-14">
          <p
            class="text-sm uppercase tracking-wide font-semibold mb-10 text-center"
            style="color: var(--club-color)"
          >
            Colaboradores
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-10 items-center">
            {collaborators.map(item => (
              <a
                href={item.url}
                target="_blank"
                class="flex items-center justify-center opacity-90 hover:opacity-100 transition"
              >
                <img
                  src={item.logo}
                  alt={item.name}
                  class="h-16 object-contain"
                />
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- CONTACTO PATROCINIO -->
      <section class="bg-gray-50">
        <div class="max-w-3xl mx-auto px-6 py-16 text-center">
          <h2 class="text-2xl font-semibold text-gray-900 mb-4">
            ¿Quieres formar parte de nuestros patrocinadores?
          </h2>

          <p class="text-gray-600 mb-8">
            Si estás interesado en colaborar con el club y apoyar el deporte
            local, puedes ponerte en contacto con nosotros y te informaremos
            sin compromiso.
          </p>

          <a
            href={`/club/${slug}/contacto`}
            class="inline-block px-6 py-3 rounded-md text-white font-medium"
            style="background-color: var(--club-color)"
          >
            Contactar con el club
          </a>
        </div>
      </section>
    </>
  )}
</BaseLayout>
