---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import ClubPageContent from "../../../components/ClubPageContent.astro";
import { clubs } from "../../../data/clubs";
import { getSupabaseServer } from "../../../lib/supabaseServer";
import { getSupabaseService } from "../../../lib/supabaseService";

const { slug } = Astro.params;
const staticClub = clubs[slug];
const slugNorm = String(slug ?? "").trim().toLowerCase();

async function loadClubAndCache(sb: ReturnType<typeof getSupabaseServer>, label: string) {
  let res = await sb.from("clubs").select("id, name, logo_url, color, page_visibility").eq("slug", String(slug ?? "").trim()).maybeSingle();
  if (res.error) console.log("[club/cache]", label, "clubs select error:", res.error.message);
  if (!res.data) res = await sb.from("clubs").select("id, name, logo_url, color, page_visibility").eq("slug", slugNorm).maybeSingle();
  let club: { id: string; name?: string; logo_url?: string; color?: string; page_visibility?: unknown } | null = res.data ?? null;
  if (!club && staticClub?.supabaseId) {
    const byId = await sb.from("clubs").select("id, name, logo_url, color, page_visibility").eq("id", staticClub.supabaseId).maybeSingle();
    club = byId.data ?? null;
    if (byId.error) console.log("[club/cache]", label, "clubs byId error:", byId.error.message);
  }
  let cache: { classification?: unknown; next_matches?: unknown } | null = null;
  if (club?.id) {
    const cacheRes = await sb.from("club_ffcv_cache").select("classification, next_matches").eq("club_id", club.id).maybeSingle();
    if (cacheRes.error) console.log("[club/cache]", label, "club_ffcv_cache error:", cacheRes.error.message);
    cache = cacheRes.data ?? null;
  }
  return { dbClub: club, cache };
}

// Cargar club + caché: primero service role (si existe), si no hay datos probar anon. Así ves clasificación/partidos con la key correcta.
function hasCacheData(c: { classification?: unknown; next_matches?: unknown } | null): boolean {
  if (!c) return false;
  const hasMatches = Array.isArray(c.next_matches) && c.next_matches.length > 0;
  const hasClass = c.classification != null && (Array.isArray(c.classification) || ((c.classification as { rows?: unknown[] })?.rows?.length ?? 0) > 0);
  return hasMatches || hasClass;
}

const supabaseAnon = getSupabaseServer(Astro.cookies);
const supabaseAdmin = getSupabaseService();
const sbFirst = supabaseAdmin ?? supabaseAnon;
const firstLabel = supabaseAdmin ? "service_role" : "anon";
console.log("[club/cache]", slug, "→ intentando primero con", firstLabel, "| service_role disponible:", !!supabaseAdmin);
let { dbClub, cache } = await loadClubAndCache(sbFirst, firstLabel);
console.log("[club/cache]", slug, "→ club:", dbClub ? dbClub.id : "null", "| cache con datos:", hasCacheData(cache));
if (!hasCacheData(cache)) {
  const sbFallback = sbFirst === supabaseAdmin ? supabaseAnon : supabaseAdmin;
  const fallbackLabel = sbFallback === supabaseAnon ? "anon" : "service_role";
  if (sbFallback) {
    console.log("[club/cache]", slug, "→ fallback con", fallbackLabel);
    const r = await loadClubAndCache(sbFallback, fallbackLabel);
    if (!dbClub) dbClub = r.dbClub;
    if (hasCacheData(r.cache)) cache = r.cache;
    console.log("[club/cache]", slug, "→ tras fallback, cache con datos:", hasCacheData(cache));
  }
}

const supabase = supabaseAnon;

const defaultVisibility: Record<string, boolean> = { saludo: true, contacto: true, galeria: true, valores: true, patrocinadores: true, historia: true, equipos: true, jornadas: true, noticias: true };
const pageVisibility = (dbClub?.page_visibility as Record<string, boolean> | null) ?? defaultVisibility;

let galleryPhotos: { image_url: string }[] = [];
const { data: albums } = await supabase.from("albums").select("id").limit(8);
const albumIds = (albums ?? []).map((a: { id: string }) => a.id);
const firstAlbumId = albumIds[0] ?? null;
if (albumIds.length > 0) {
  const { data: photos } = await supabase.from("photos").select("image_url").in("album_id", albumIds).limit(25);
  galleryPhotos = (photos ?? []).sort(() => Math.random() - 0.5).slice(0, 12);
} else {
  const { data: anyPhotos } = await supabase.from("photos").select("image_url").limit(15);
  galleryPhotos = (anyPhotos ?? []).sort(() => Math.random() - 0.5).slice(0, 10);
}

const club = {
  name: dbClub?.name ?? staticClub?.name ?? "Club",
  slug: staticClub?.slug ?? slug,
  logo: dbClub?.logo_url || staticClub?.logo || "/favicon.svg",
  color: dbClub?.color ?? staticClub?.color ?? "#1f2937",
};

const classificationRaw = cache?.classification;
const classification = (Array.isArray(classificationRaw)
  ? classificationRaw
  : (classificationRaw && typeof classificationRaw === "object" && !Array.isArray(classificationRaw)
    ? ((classificationRaw as { rows?: unknown[]; data?: unknown[] }).rows ?? (classificationRaw as { data?: unknown[] }).data ?? [])
    : [])) as Array<{ position: number; team: string; logo_url?: string; j: number; g: number; e: number; p: number; gf: number; gc: number; dif: number; pts: number }>;
// Por si la caché antigua guardó strings ("13 72%", etc.), mostramos solo el primer número
function num(val: unknown): number {
  if (typeof val === "number" && !Number.isNaN(val)) return val;
  const m = String(val ?? "").match(/^(-?\d+)/);
  return m ? parseInt(m[1], 10) : 0;
}
type NextMatchItem = { date: string; time: string; local: string; visitor: string; local_logo?: string; visitor_logo?: string; competition?: string; stadium?: string };
const nextMatchesRawUnsafe = cache?.next_matches;
const nextMatchesRaw: NextMatchItem[] = Array.isArray(nextMatchesRawUnsafe)
  ? (nextMatchesRawUnsafe as NextMatchItem[])
  : (nextMatchesRawUnsafe && typeof nextMatchesRawUnsafe === "object" && Array.isArray((nextMatchesRawUnsafe as { items?: unknown[] }).items))
    ? ((nextMatchesRawUnsafe as { items: NextMatchItem[] }).items)
    : [];
const nextMatches = nextMatchesRaw;
const hasMoreMatches = nextMatchesRaw.length > 12;

const latestNews = [
  { id: 1, title: "Victoria importante del primer equipo", date: "10 Febrero", image: club.logo, image_url: null as string | null },
  { id: 2, title: "Cambio de horarios esta semana", date: "8 Febrero", image: club.logo, image_url: null as string | null },
];
const clubColorStyle = { color: "var(--club-color)" };
const clubBgStyle = { background: "var(--club-color)" };
const clubVar = "var(--club-color)";
const clubVarFallback = "var(--club-color, #1f2937)";
const clubBlockStyle = { "--club": clubVarFallback };
const clubHeroStyle = { "--club": clubVar };
const galleryHref = firstAlbumId ? `/club/${slug}/galeria/${firstAlbumId}` : "#";
const clubRowStyle = { "--club": clubVarFallback };

const pageData = {
  club: { name: club.name, logo: club.logo, color: club.color },
  slug,
  galleryHref,
  galleryPhotos,
  styles: { clubColorStyle, clubBgStyle, clubBlockStyle, clubHeroStyle, clubRowStyle },
  latestNews,
  nextMatches,
  hasMoreMatches,
  classification,
  pageVisibility: pageVisibility as Record<string, boolean>,
};
---

<BaseLayout
  title={club?.name ?? "Club no encontrado"}
  color={club?.color}
>
  {!staticClub && !dbClub ? (
    <div class="min-h-[60vh] flex items-center justify-center px-6">
      <div class="text-center">
        <h1 class="text-2xl font-bold text-gray-900">Club no encontrado</h1>
        <p class="mt-2 text-gray-600">El club que buscas no existe o no está disponible.</p>
        <a href="/" class="mt-6 inline-block text-orange-600 font-medium hover:underline">Volver al inicio</a>
      </div>
    </div>
  ) : (
    <>
      <ClubPageContent data={pageData} />

      <style>
        /* —— Hero y animaciones —— */
        .hero-club__bg {
          position: absolute;
          inset: 0;
          background: linear-gradient(135deg, var(--club) 0%, color-mix(in srgb, var(--club) 60%, #000) 50%, #0f172a 100%);
          background-size: 200% 200%;
          animation: hero-gradient 12s ease infinite;
        }
        @keyframes hero-gradient {
          0%, 100% { background-position: 0% 50%; }
          50% { background-position: 100% 50%; }
        }
        .animate-fade-in {
          animation: fade-in 0.8s ease-out forwards;
        }
        .animate-fade-in-up {
          animation: fade-in-up 0.8s ease-out 0.2s forwards;
          opacity: 0;
        }
        .hero-club__btn {
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
          padding: 0.875rem 1.5rem;
          border-radius: 0.75rem;
          font-weight: 600;
          text-decoration: none;
          color: #fff;
          transition: opacity 0.2s, transform 0.2s;
        }
        .hero-club__btn:hover { opacity: 0.95; transform: scale(1.02); }
        .hero-club__btn--primary { background: var(--club-color); }
        .hero-club__btn--secondary {
          background: rgb(255 255 255 / 0.15);
          border: 1px solid rgb(255 255 255 / 0.3);
          backdrop-filter: blur(8px);
        }
        .hero-club__btn--secondary:hover { background: rgb(255 255 255 / 0.25); }
        @keyframes fade-in {
          from { opacity: 0; transform: translateY(10px); }
          to { opacity: 1; transform: translateY(0); }
        }
        @keyframes fade-in-up {
          from { opacity: 0; transform: translateY(16px); }
          to { opacity: 1; transform: translateY(0); }
        }

        /* —— Galería deslizante —— */
        .gallery-strip {
          overflow: hidden;
          mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
          -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
        }
        .gallery-strip__track {
          display: flex;
          gap: 1rem;
          width: max-content;
          animation: gallery-slide 45s linear infinite;
        }
        .gallery-strip__track:hover {
          animation-play-state: paused;
        }
        .gallery-strip__slide {
          transition: transform 0.2s;
        }
        @keyframes gallery-slide {
          0% { transform: translateX(0); }
          100% { transform: translateX(-50%); }
        }

        /* —— Bloques con identidad —— */
        .block-head {
          display: flex;
          align-items: center;
          gap: 0.75rem;
          margin-bottom: 1.25rem;
          flex-wrap: wrap;
        }
        .block-head__strip {
          width: 4px;
          height: 2rem;
          border-radius: 2px;
          background: var(--club);
        }
        .block-head__title {
          font-size: 1.35rem;
          font-weight: 800;
          color: #0f172a;
          letter-spacing: -0.02em;
          margin: 0;
        }
        .block-head__tag {
          font-size: 0.7rem;
          font-weight: 600;
          text-transform: uppercase;
          letter-spacing: 0.08em;
          color: var(--club);
          background: color-mix(in srgb, var(--club) 14%, transparent);
          padding: 0.25rem 0.6rem;
          border-radius: 999px;
        }

        /* —— Últimas noticias (cartas con foto) + galería —— */
        .news-list {
          list-style: none;
          margin: 0;
          padding: 0;
        }
        .news-list--cards {
          display: grid;
          gap: 1rem;
        }
        .news-card-home {
          display: flex;
          flex-direction: column;
          background: #fff;
          border: 1px solid #e2e8f0;
          border-radius: 1rem;
          overflow: hidden;
          text-decoration: none;
          color: inherit;
          transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
        }
        html[data-theme="dark"] .news-card-home {
          background: #1e293b;
          border-color: #334155;
        }
        .news-card-home:hover {
          border-color: color-mix(in srgb, var(--club) 35%, #e2e8f0);
          box-shadow: 0 12px 28px -10px rgb(0 0 0 / 0.12);
          transform: translateY(-2px);
        }
        .news-card-home:hover .news-card-home__cta { text-decoration: underline; }
        .news-card-home__img-wrap {
          position: relative;
          aspect-ratio: 16 / 7;
          max-height: 110px;
          background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
          overflow: hidden;
          display: flex;
          align-items: center;
          justify-content: center;
        }
        html[data-theme="dark"] .news-card-home__img-wrap {
          background: linear-gradient(135deg, #334155 0%, #475569 100%);
        }
        .news-card-home__placeholder {
          font-size: 1.75rem;
          opacity: 0.5;
        }
        .news-card-home__img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          transition: transform 0.3s;
        }
        .news-card-home__img--logo {
          object-fit: contain;
          max-height: 72px;
          width: auto;
          max-width: 100%;
        }
        .news-card-home__img-wrap:has(.news-card-home__img--logo) {
          padding: 0.5rem;
        }
        .news-card-home:hover .news-card-home__img { transform: scale(1.03); }
        .news-card-home__date {
          position: absolute;
          bottom: 0.5rem;
          left: 0.5rem;
          font-size: 0.7rem;
          font-weight: 600;
          color: #fff;
          background: rgb(0 0 0 / 0.55);
          padding: 0.2rem 0.5rem;
          border-radius: 999px;
        }
        .news-card-home__body {
          padding: 1rem 1.25rem 1.1rem;
          display: flex;
          flex-direction: column;
          gap: 0.4rem;
        }
        .news-card-home__title {
          font-weight: 700;
          color: #0f172a;
          font-size: 0.9375rem;
          line-height: 1.35;
          display: -webkit-box;
          -webkit-line-clamp: 2;
          -webkit-box-orient: vertical;
          overflow: hidden;
        }
        html[data-theme="dark"] .news-card-home__title { color: #f1f5f9; }
        .news-card-home__cta {
          font-size: 0.85rem;
          font-weight: 600;
          margin-top: 0.2rem;
        }
        .gallery-empty {
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 0.5rem;
          padding: 2.5rem 1rem;
          color: #64748b;
          font-size: 0.95rem;
        }
        html[data-theme="dark"] .gallery-empty { color: #94a3b8; }
        .gallery-empty__icon { font-size: 2.5rem; opacity: 0.7; }
        .gallery-empty__text { margin: 0; }

        /* —— Próximos partidos: carrusel —— */
        .next-matches-block { --club: #1f2937; }
        .matches-arena {
          background: linear-gradient(160deg, color-mix(in srgb, var(--club) 6%, #fff) 0%, #f8fafc 50%, #fff 100%);
          border-radius: 1.25rem;
          border: 1px solid color-mix(in srgb, var(--club) 18%, #e2e8f0);
          box-shadow: 0 8px 24px -8px color-mix(in srgb, var(--club) 15%, rgb(0 0 0 / 0.08));
          padding: 1.5rem;
          overflow: hidden;
          min-height: 420px;
        }
        .matches-strip {
          overflow-x: auto;
          overflow-y: hidden;
          margin: 0 -0.25rem;
          padding: 0.25rem;
          scroll-snap-type: x mandatory;
          -webkit-overflow-scrolling: touch;
          cursor: grab;
        }
        .matches-strip:active { cursor: grabbing; }
        .matches-strip__track {
          display: flex;
          gap: 1.25rem;
          width: max-content;
          padding: 0.25rem 0.5rem;
        }
        .matches-strip__pair {
          display: flex;
          flex-direction: column;
          gap: 0.75rem;
          width: 300px;
          flex-shrink: 0;
          scroll-snap-align: start;
        }
        .match-fixture--card {
          flex-shrink: 0;
          width: 100%;
          min-width: 0;
        }
        .matches-more {
          margin: 0.75rem 0 0;
          padding-top: 0.75rem;
          border-top: 1px dashed #e2e8f0;
          text-align: center;
        }
        html[data-theme="dark"] .matches-more { border-top-color: #334155; }
        .matches-more__link {
          font-size: 0.85rem;
          font-weight: 600;
          color: var(--club);
        }
        .matches-more__link:hover { text-decoration: underline; }
        .match-fixture {
          background: #fff;
          border-radius: 1rem;
          overflow: hidden;
          border: 1px solid #e2e8f0;
          transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
        }
        html[data-theme="dark"] .match-fixture {
          background: #1e293b;
          border-color: #334155;
        }
        html[data-theme="dark"] .fixture-team__name { color: #e2e8f0; }
        html[data-theme="dark"] .table-arena {
          background: linear-gradient(160deg, #1e293b 0%, #0f172a 100%);
          border-color: #334155;
        }
        html[data-theme="dark"] .league-table tbody tr { border-color: #334155; }
        html[data-theme="dark"] .league-table td { color: #cbd5e1; }
        html[data-theme="dark"] .lt-club-cell__name { color: #f1f5f9; }
        .match-fixture:hover {
          transform: translateY(-2px);
          box-shadow: 0 12px 28px -10px rgb(0 0 0 / 0.12);
          border-color: color-mix(in srgb, var(--club) 35%, #e2e8f0);
        }
        .fixture-date {
          background: linear-gradient(90deg, var(--club), color-mix(in srgb, var(--club) 75%, #000));
          padding: 0.4rem 1rem;
          text-align: center;
        }
        .fixture-date__text {
          font-size: 0.7rem;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.1em;
          color: rgb(255 255 255 / 0.95);
        }
        .fixture-body {
          display: flex;
          align-items: center;
          gap: 0.75rem;
          padding: 1rem 1.25rem;
          flex-wrap: wrap;
        }
        .fixture-team {
          display: flex;
          align-items: center;
          gap: 0.6rem;
          min-width: 0;
          flex: 1 1 0;
        }
        .fixture-team--local { justify-content: flex-end; }
        .fixture-team--visitor { justify-content: flex-start; }
        .fixture-team__crest {
          width: 2.5rem;
          height: 2.5rem;
          border-radius: 50%;
          overflow: hidden;
          background: #f1f5f9;
          display: flex;
          align-items: center;
          justify-content: center;
          flex-shrink: 0;
          border: 2px solid #e2e8f0;
        }
        .fixture-team__crest img {
          width: 100%;
          height: 100%;
          object-fit: contain;
        }
        .fixture-team__crest-placeholder {
          width: 100%;
          height: 100%;
          background: linear-gradient(135deg, #e2e8f0, #cbd5e1);
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 0.9rem;
          font-weight: 800;
          color: #64748b;
          line-height: 1;
        }
        html[data-theme="dark"] .fixture-team__crest-placeholder {
          background: linear-gradient(135deg, #475569, #334155);
          color: #94a3b8;
        }
        .fixture-team__name {
          font-size: 0.9rem;
          font-weight: 700;
          color: #1e293b;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
        .fixture-divider {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 0.2rem;
          flex-shrink: 0;
          padding: 0.5rem 0.75rem;
          background: #f8fafc;
          border-radius: 0.75rem;
          border: 1px solid #e2e8f0;
          min-width: 4rem;
        }
        .fixture-time {
          font-size: 0.85rem;
          font-weight: 800;
          color: var(--club);
          font-variant-numeric: tabular-nums;
        }
        .fixture-vs {
          font-size: 0.6rem;
          font-weight: 800;
          color: #94a3b8;
          letter-spacing: 0.12em;
        }
        .fixture-meta {
          display: flex;
          align-items: flex-start;
          gap: 0.35rem;
          padding: 0.5rem 1.25rem 0.75rem;
          font-size: 0.72rem;
          line-height: 1.35;
          color: #64748b;
        }
        .fixture-meta__icon { font-size: 0.75rem; opacity: 0.9; flex-shrink: 0; margin-top: 0.1em; }
        .fixture-meta__text {
          word-wrap: break-word;
          overflow-wrap: break-word;
          white-space: normal;
        }
        .matches-empty {
          color: #64748b;
          font-size: 0.9rem;
          padding: 2rem 1rem;
          text-align: center;
        }
        .matches-empty__icon { display: block; font-size: 2rem; margin-bottom: 0.5rem; opacity: 0.6; }
        .table-empty { margin: 1.5rem 0; }

        /* —— CTA Contacto (dos opciones) —— */
        .cta-contact__grid {
          display: grid;
          gap: 1.5rem;
          max-width: 42rem;
          margin: 0 auto;
        }
        @media (min-width: 640px) {
          .cta-contact__grid { grid-template-columns: 1fr 1fr; }
        }
        .cta-contact__card {
          display: flex;
          flex-direction: column;
          align-items: flex-start;
          padding: 1.5rem 1.75rem;
          background: #fff;
          border: 1px solid #e2e8f0;
          border-radius: 1.25rem;
          text-decoration: none;
          color: inherit;
          transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
        }
        html[data-theme="dark"] .cta-contact__card {
          background: #1e293b;
          border-color: #334155;
        }
        .cta-contact__card:hover {
          border-color: color-mix(in srgb, var(--club) 40%, #e2e8f0);
          box-shadow: 0 12px 28px -10px rgb(0 0 0 / 0.12);
          transform: translateY(-2px);
        }
        .cta-contact__icon {
          width: 3rem;
          height: 3rem;
          border-radius: 0.75rem;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 1.5rem;
          margin-bottom: 1rem;
        }
        .cta-contact__card-title {
          font-size: 1.1rem;
          font-weight: 700;
          color: #0f172a;
          margin: 0 0 0.35rem;
        }
        html[data-theme="dark"] .cta-contact__card-title { color: #f1f5f9; }
        .cta-contact__card-desc {
          font-size: 0.9rem;
          color: #64748b;
          margin: 0 0 1rem;
          line-height: 1.45;
        }
        html[data-theme="dark"] .cta-contact__card-desc { color: #94a3b8; }
        .cta-contact__card-link {
          font-size: 0.9rem;
          font-weight: 600;
          margin-top: auto;
        }
        .cta-contact__card:hover .cta-contact__card-link { text-decoration: underline; }

        /* —— Clasificación —— */
        .classification-block { --club: #1f2937; max-width: 80rem; margin: 0 auto; padding: 0 1.5rem 3.5rem; }
        .table-arena {
          background: linear-gradient(160deg, #fff 0%, color-mix(in srgb, var(--club) 5%, #f8fafc) 100%);
          border-radius: 1.25rem;
          border: 1px solid color-mix(in srgb, var(--club) 20%, #e2e8f0);
          box-shadow: 0 8px 24px -8px color-mix(in srgb, var(--club) 12%, rgb(0 0 0 / 0.08));
          overflow: hidden;
        }
        .league-table {
          width: 100%;
          border-collapse: collapse;
          font-size: 0.875rem;
        }
        .league-table thead tr {
          background: linear-gradient(90deg, var(--club), color-mix(in srgb, var(--club) 85%, #0f172a));
